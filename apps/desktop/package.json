{
  "name": "@sia/desktop",
  "version": "0.1.0-alpha.25",
  "private": true,
  "description": "A local-first personal computer assistant for macOS.",
  "author": "Lawrence Jang",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "cloud-config:prepare": "node scripts/prepare-cloud-config.mjs --allow-disabled",
    "cloud-config:prepare:release": "node scripts/prepare-cloud-config.mjs --require-enabled",
    "clean": "rimraf out release coverage test-results playwright-report",
    "dev": "node scripts/dev.mjs",
    "icon:build": "node scripts/build-icon.mjs",
    "licenses:build": "node scripts/build-third-party-licenses.mjs",
    "package:mac": "node scripts/verify-release-environment.mjs && rimraf release && pnpm cloud-config:prepare:release && pnpm icon:build && pnpm -w build && electron-builder --mac --universal && node scripts/finalize-release-artifacts.mjs --arch=universal && node scripts/verify-packaged-app.mjs --arch=universal --signing=release",
    "package:mac:arm64:dir": "rimraf release && pnpm cloud-config:prepare && pnpm icon:build && pnpm -w build && electron-builder --mac --arm64 --dir --config.mac.identity=null --config.mac.notarize=false && node scripts/verify-packaged-app.mjs --arch=arm64 --signing=unsigned",
    "package:mac:dir": "rimraf release && pnpm cloud-config:prepare && pnpm icon:build && pnpm -w build && electron-builder --mac --universal --dir --config.mac.identity=null --config.mac.notarize=false && node scripts/verify-packaged-app.mjs --arch=universal --signing=unsigned",
    "signing:setup": "bash scripts/setup-signing.sh",
    "voice:configure": "node scripts/configure-personal-voice.mjs",
    "preview": "node scripts/preview.mjs",
    "prebuild": "pnpm licenses:build && pnpm native:build && pnpm remote:build",
    "test": "pnpm native:test && vitest run",
    "test:e2e": "pnpm -w build && playwright test",
    "test:e2e:parity": "pnpm -w build && playwright test parity/parity.spec.ts",
    "test:e2e:parity:strict": "SIA_PARITY_REQUIRE_COMPLETE=1 pnpm test:e2e:parity",
    "test:e2e:parity:incomplete": "SIA_PARITY_ALLOW_INCOMPLETE=1 pnpm test:e2e:parity",
    "test:e2e:real:no-turn": "pnpm -w build && playwright test e2e/real-no-turn.spec.ts",
    "test:e2e:real:capabilities": "pnpm -w build && playwright test e2e/real-capabilities.spec.ts",
    "typecheck": "tsc --noEmit",
    "native:build": "node scripts/build-voice-helper.mjs",
    "predev": "pnpm native:build && pnpm remote:build && node scripts/prepare-dev-electron.mjs",
    "native:test": "node scripts/build-voice-helper.mjs && node scripts/port-notch-prompts.mjs --check && node --test scripts/prepare-dev-electron.test.mjs scripts/release-identity.test.mjs && node scripts/test-voice-helper.mjs",
    "remote:build": "vite build --config vite.remote.config.ts",
    "test:remote": "pnpm remote:build && playwright test --config playwright.remote.config.ts",
    "test:renderer": "playwright test --config playwright.renderer.config.ts"
  },
  "dependencies": {
    "@trycua/cua-driver": "0.21.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@trycua/cua-driver-darwin-arm64": "0.21.0",
    "@trycua/cua-driver-darwin-x64": "0.21.0",
    "@ubjs/node-darwin-arm64": "0.31.0-3",
    "@ubjs/node-darwin-x64": "0.31.0-3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@paper-design/shaders": "0.0.81",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.2",
    "@sia/action-gateway": "workspace:*",
    "@sia/protocol": "workspace:*",
    "@sia/runtime": "workspace:*",
    "@sia/tool-bridge": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.1.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.2",
    "three": "^0.180.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.sia.desktop",
    "productName": "Sia",
    "copyright": "Copyright © 2026 Superintelligent Agents, Inc.",
    "artifactName": "Sia-${version}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/@trycua/cua-driver/**",
      "node_modules/@trycua/cua-driver-*/**",
      "node_modules/@ubjs/node-darwin-*/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "build/THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      },
      {
        "from": "build/ELECTRON_LICENSE.txt",
        "to": "ELECTRON_LICENSE.txt"
      },
      {
        "from": "build/CHROMIUM_LICENSES.html",
        "to": "CHROMIUM_LICENSES.html"
      },
      {
        "from": "../../patches/@ubjs__node@0.31.0-3.patch",
        "to": "patches/@ubjs__node@0.31.0-3.patch"
      },
      {
        "from": "build/sia-cloud.json",
        "to": "sia-cloud.json"
      },
      {
        "from": "build/native/SiaVoiceHelper",
        "to": "native/SiaVoiceHelper"
      }
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "afterPack": "build/after-pack.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "notarize": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/{@trycua,@ubjs}/**/*",
      "extendInfo": {
        "NSAccessibilityUsageDescription": "Sia uses Accessibility to click and type in apps when you ask it to do something on your Mac, and for the optional Fn talk shortcut.",
        "NSScreenCaptureDescription": "Sia uses Screen Recording to see the apps it's working in when you give it a task on your Mac.",
        "NSMicrophoneUsageDescription": "Sia uses the microphone only while you're speaking a request to it.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        },
        "NSSpeechRecognitionUsageDescription": "Sia uses on-device speech recognition when you choose dictation.",
        "NSAppleEventsUsageDescription": "Sia uses this to work in apps like Calendar, Reminders, Messages and Safari when you give it a task.",
        "NSLocalNetworkUsageDescription": "Sia connects to your phone on the same Wi-Fi when you enable Phone remote.",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      },
      "target": [
        "dmg",
        "zip"
      ],
      "binaries": [
        "Contents/Resources/native/SiaVoiceHelper"
      ]
    },
    "dmg": {
      "sign": true,
      "window": {
        "width": 600,
        "height": 390
      },
      "contents": [
        {
          "x": 175,
          "y": 190
        },
        {
          "x": 425,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
