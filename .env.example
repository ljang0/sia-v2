# Development desktop control plane only. Packaged apps ignore these variables.
# Leave all three blank to run local providers without Sia cloud services.
SIA_API_BASE_URL=https://api.example.invalid
SIA_COGNITO_CLIENT_ID=
SIA_COGNITO_REGION=us-east-1

# Development only. Production credentials belong in AWS Secrets Manager or the signed release job.
SIA_FAKE_SERVICES=1
SIA_DEV_ID_TOKEN=

# Release operator inputs. Keep real values in the protected release environment, not this file.
SIA_BOOTSTRAP_ADMIN_EMAIL=
SIA_DELETION_ALARM_TOPIC_ARN=
SIA_RELEASE_API_BASE_URL=
SIA_RELEASE_COGNITO_REGION=us-east-1
SIA_RELEASE_COGNITO_CLIENT_ID=
CSC_LINK=
CSC_KEY_PASSWORD=
CSC_NAME=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
APPLE_KEYCHAIN_PROFILE=
