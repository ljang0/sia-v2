+/// One operation's flattened attachment. Parent attachments also own any
+/// auto-attached frame sessions. Keep it alive through input/readback and
+/// release it on every normal return, refusal or future cancellation.
+pub(crate) struct AttachedSession {
+    connection: Arc<CdpConnection>,
+    id: String,
+}
+
+impl std::ops::Deref for AttachedSession {
+    type Target = String;
+
+    fn deref(&self) -> &Self::Target {
+        &self.id
+    }
+}
+
+impl Drop for AttachedSession {
+    fn drop(&mut self) {
+        // Dialog inspection deliberately retains one Page-enabled observer
+        // per target until this bounded browser connection closes.
+        if self.connection.is_dialog_session(&self.id) {
+            return;
+        }
+        // Drop cannot await. The connection's bounded call owns cleanup,
+        // without detaching another operation's session or closing a shared
+        // browser socket. Runtime teardown closes the socket itself.
+        if let Ok(runtime) = tokio::runtime::Handle::try_current() {
+            let connection = self.connection.clone();
+            let id = self.id.clone();
+            runtime.spawn(async move {
+                let _ = connection.call(None, "Target.detachFromTarget",
+                    json!({ "sessionId": id })).await;
+            });
+        }
+    }
+}
