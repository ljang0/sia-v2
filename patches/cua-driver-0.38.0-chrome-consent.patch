index 0000000..0d93d73
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/tools/type_text/cancellation.rs
@@ -0,0 +1,82 @@
+//! Cancels a blocking visual-text writer when its async operation is dropped.
+//! The writer keeps its mutation lease until it observes cancellation and exits.
+
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+
+pub(super) struct Checkpoint(Arc<AtomicBool>);
+
+impl Checkpoint {
+    pub(super) fn check(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            !self.0.load(Ordering::Acquire),
+            "Native text entry cancelled."
+        );
+        Ok(())
+    }
+}
+
+struct CancelOnDrop(Arc<AtomicBool>);
+
+impl Drop for CancelOnDrop {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::Release);
+    }
+}
+
+pub(super) async fn run<T: Send + 'static>(
+    work: impl FnOnce(Checkpoint) -> T + Send + 'static,
+) -> Result<T, tokio::task::JoinError> {
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let _cancel_on_drop = CancelOnDrop(cancelled.clone());
+    tokio::task::spawn_blocking(move || work(Checkpoint(cancelled))).await
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{mpsc, Mutex};
+    use std::time::Duration;
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn cancelling_the_async_wait_stops_the_inflight_writer() {
+        let written = Arc::new(Mutex::new(Vec::new()));
+        let output = written.clone();
+        let (started_tx, started_rx) = tokio::sync::oneshot::channel();
+        let (resume_tx, resume_rx) = mpsc::channel();
+        let (finished_tx, finished_rx) = tokio::sync::oneshot::channel();
+        let task = tokio::spawn(run(move |checkpoint| {
+            let result = (|| -> anyhow::Result<()> {
+                checkpoint.check()?;
+                output.lock().unwrap().push('a');
+                started_tx.send(()).unwrap();
+                resume_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+                checkpoint.check()?;
+                output.lock().unwrap().push('b');
+                Ok(())
+            })();
+            finished_tx.send(result.is_err()).unwrap();
+        }));
+        started_rx.await.unwrap();
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        resume_tx.send(()).unwrap();
+        assert!(finished_rx.await.unwrap());
+        assert_eq!(*written.lock().unwrap(), vec!['a']);
+    }
+
+    #[tokio::test]
+    async fn completed_writer_is_not_cancelled_while_running() {
+        let result = run(|checkpoint| {
+            checkpoint.check()?;
+            checkpoint.check()?;
+            Ok::<_, anyhow::Error>("complete")
+        })
+        .await
+        .unwrap()
+        .unwrap();
+        assert_eq!(result, "complete");
+    }
+}
