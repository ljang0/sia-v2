+    pub y: f64,
+    pub width: f64,
+    pub height: f64,
+}
+impl Rect {
+    pub fn valid(self) -> bool {
+        [self.x, self.y, self.width, self.height]
+            .iter()
+            .all(|v| v.is_finite())
+            && self.width > 0.0
+            && self.height > 0.0
+    }
+    pub fn contains(self, x: f64, y: f64) -> bool {
+        x.is_finite()
+            && y.is_finite()
+            && x >= self.x
+            && y >= self.y
+            && x < self.x + self.width
+            && y < self.y + self.height
+    }
+    fn union(self, other: Self) -> Self {
+        let x = self.x.min(other.x);
+        let y = self.y.min(other.y);
+        Self {
+            x,
+            y,
+            width: (self.x + self.width).max(other.x + other.width) - x,
+            height: (self.y + self.height).max(other.y + other.height) - y,
+        }
+    }
+    pub fn near(self, other: Self) -> bool {
+        [
+            self.x - other.x,
+            self.y - other.y,
+            self.width - other.width,
+            self.height - other.height,
+        ]
+        .iter()
+        .all(|v| v.abs() < 0.5)
+    }
+}
+impl From<&WindowBounds> for Rect {
+    fn from(b: &WindowBounds) -> Self {
+        Self {
+            x: b.x,
+            y: b.y,
+            width: b.width,
+            height: b.height,
+        }
+    }
+}
+impl From<Rect> for WindowBounds {
+    fn from(b: Rect) -> Self {
+        Self {
+            x: b.x,
+            y: b.y,
+            width: b.width,
+            height: b.height,
+        }
+    }
+}
+impl From<screencapturekit::cg::CGRect> for Rect {
+    fn from(b: screencapturekit::cg::CGRect) -> Self {
+        Self {
+            x: b.origin.x,
+            y: b.origin.y,
+            width: b.size.width,
+            height: b.size.height,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Sheet {
+    pub window_id: u32,
+    pub bounds: Rect,
+}
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Surface {
+    pub window_id: u32,
+    pub pid: i32,
+    pub parent: Rect,
+    pub sheet: Option<Sheet>,
+}
+impl Surface {
+    pub fn read(window_id: u32) -> anyhow::Result<Self> {
+        let info = crate::windows::window_info_by_id(window_id)
+            .ok_or_else(|| anyhow::anyhow!("capture window disappeared"))?;
+        let parent = Rect::from(&info.bounds);
+        anyhow::ensure!(parent.valid(), "invalid parent geometry");
+        let sheet = crate::ax::sheet_point::focused_sheet_geometry(info.pid, window_id)?;
+        Ok(Self {
+            window_id,
+            pid: info.pid,
+            parent,
+            sheet,
+        })
+    }
+    pub fn source(&self) -> Rect {
+        self.sheet
+            .as_ref()
+            .map_or(self.parent, |s| self.parent.union(s.bounds))
+    }
+    pub fn ensure_current(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            Self::read(self.window_id)? == *self,
+            "window or attached sheet changed during capture"
+        );
+        Ok(())
+    }
+}
+
+/// Why a window-local pixel action cannot be translated.
+#[derive(Debug, Clone, PartialEq)]
+pub enum PxFrameError {
+    /// WindowServer has no usable frame for this id: it was closed, the id is
+    /// stale or fabricated, or the record carries degenerate `0×0` bounds
+    /// (`windows.rs`'s missing-`kCGWindowBounds` default), which would make
+    /// the window origin indistinguishable from the screen origin.
+    WindowNotFound { window_id: u32 },
+    /// The current capture could not be obtained or decoded, so its pixel
+    /// coordinate system cannot be proven against the WindowServer frame.
+    CaptureUnavailable { window_id: u32, reason: String },
+    /// The capture dimensions are not a coherent 1×/2× representation of the
+    /// requested WindowServer frame. Dispatching with this transform would
+    /// recreate #2237's wrong-surface misclick.
+    FrameMismatch {
+        window_id: u32,
+        bounds_width: f64,
+        bounds_height: f64,
+        capture_width: u32,
+        capture_height: u32,
+        scale_x: f64,
+        scale_y: f64,
+    },
+}
+
+/// Validate that a raw window capture and its WindowServer bounds describe one
+/// coordinate frame, returning the physical-pixels-per-point backing scale.
+///
+/// macOS window captures are 1× or 2×. Small rounding differences are allowed,
+/// but arbitrary ratios are not: the original #2237 failure paired a parent
+/// window screenshot with panel bounds and would otherwise look like a
+/// plausible-but-wrong ~2.2× scale.
+pub fn parent_backing_scale(
+    window_id: u32,
+    bounds: &WindowBounds,
+    capture_px_w: u32,
+    capture_px_h: u32,
+) -> Result<f64, PxFrameError> {
+    if bounds.width <= 0.0 || bounds.height <= 0.0 {
+        return Err(PxFrameError::WindowNotFound { window_id });
+    }
+    let scale_x = capture_px_w as f64 / bounds.width;
+    let scale_y = capture_px_h as f64 / bounds.height;
+    let nearest = if (scale_x - 1.0).abs() <= (scale_x - 2.0).abs() {
+        1.0
+    } else {
+        2.0
+    };
+    let coherent = scale_x.is_finite()
+        && scale_y.is_finite()
+        && (scale_x - scale_y).abs() <= 0.03
+        && (scale_x - nearest).abs() <= 0.03
+        && (scale_y - nearest).abs() <= 0.03;
+    if coherent {
+        Ok(nearest)
+    } else {
+        Err(PxFrameError::FrameMismatch {
+            window_id,
+            bounds_width: bounds.width,
+            bounds_height: bounds.height,
+            capture_width: capture_px_w,
+            capture_height: capture_px_h,
+            scale_x,
+            scale_y,
+        })
+    }
+}
+
+/// Native image coordinates. `content` is in image pixels, `source` in screen points.
+/// This is host-only validation data, not an additional model targeting surface.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Geometry {
+    pub surface: Surface,
+    pub content: Rect,
+    pub pixels_per_point: f64,
+    pub width: u32,
+    pub height: u32,
+}
+impl Geometry {
+    pub fn from_sample(
+        surface: Surface,
+        width: u32,
+        height: u32,
+        screen: Rect,
+        content: Rect,
+        backing: f64,
+        content_scale: f64,
+    ) -> anyhow::Result<Self> {
+        anyhow::ensure!(
+            surface.parent.near(screen),
+            "sample belongs to a different window frame"
+        );
+        anyhow::ensure!(
+            content.valid()
+                && [1.0, 2.0].iter().any(|v| (backing - v).abs() < 0.001)
+                && content_scale.is_finite()
+                && content_scale > 0.0
+                && content_scale <= 1.001,
+            "invalid sample content geometry"
+        );
+        let scale = backing * content_scale;
+        let content = Rect {
+            x: content.x * backing,
+            y: content.y * backing,
+            width: content.width * backing,
+            height: content.height * backing,
+        };
+        let source = surface.source();
+        anyhow::ensure!(
+            (source.width * scale - content.width).abs() < 1.0
+                && (source.height * scale - content.height).abs() < 1.0,
+            "sample contains an unproven surface or changed sheet"
+        );
+        anyhow::ensure!(
+            width > 0
+                && height > 0
+                && content.x >= 0.0
+                && content.y >= 0.0
+                && content.x + content.width <= f64::from(width) + 0.01
+                && content.y + content.height <= f64::from(height) + 0.01,
+            "sample content lies outside its pixel buffer"
+        );
+        Ok(Self {
+            surface,
+            content,
+            pixels_per_point: scale,
+            width,
+            height,
+        })
+    }
+    pub fn to_screen(&self, x: f64, y: f64) -> Option<(f64, f64)> {
+        if !self.content.contains(x, y) {
+            return None;
+        }
+        let source = self.surface.source();
+        Some((
+            source.x + (x - self.content.x) / self.pixels_per_point,
+            source.y + (y - self.content.y) / self.pixels_per_point,
+        ))
+    }
+    pub fn to_pixels(&self, x: f64, y: f64) -> (f64, f64) {
+        let source = self.surface.source();
+        (
+            self.content.x + (x - source.x) * self.pixels_per_point,
+            self.content.y + (y - source.y) * self.pixels_per_point,
+        )
+    }
+    pub fn matches(&self, other: &Self) -> bool {
+        self.surface == other.surface
+            && self.width == other.width
+            && self.height == other.height
+            && self.content.near(other.content)
+            && (self.pixels_per_point - other.pixels_per_point).abs() < 0.000001
+    }
+}
+
+pub struct CapturedWindow {
+    pub png: Vec<u8>,
+    pub geometry: Geometry,
+}
+impl AsRef<[u8]> for CapturedWindow {
+    fn as_ref(&self) -> &[u8] {
+        &self.png
+    }
+}
+
+#[cfg(test)]
+mod tests {
