+#[tokio::test]
+async fn completed_browser_operations_release_their_parent_cdp_sessions() {
+    let f = fixture_with(|st| st.oopif_present = false).await;
+    let (target, tab) = bind(&f).await;
+    for _ in 0..3 {
+        let snap = semantic_snapshot(&f, &target, &tab).await;
+        assert_eq!(snap["status"], "ok", "{snap}");
+    }
+    let validated = f.engine.revalidate_for_mutation(SESSION, &target, Some(&tab))
+        .await.expect("valid exact tab");
+    let live_session = validated.cdp_session.clone();
+    // A failed independent operation must clean up its own attachment without
+    // releasing this still-live validation on the same tab and connection.
+    f.state.lock().unwrap().screenshot_data = "not-a-png".to_owned();
+    assert!(f.engine.capture_tab_screenshot(SESSION, &target, &tab, None).await.is_err());
+    assert!(!recorded_calls(&f, "Target.detachFromTarget").iter()
+        .any(|(_, params)| params["sessionId"] == live_session),
+        "a live operation must retain its attachment");
+    drop(validated);
+    let attached = f.state.lock().unwrap().tab_sessions;
+    tokio::time::timeout(std::time::Duration::from_secs(1), async {
+        loop {
+            let detached = recorded_calls(&f, "Target.detachFromTarget");
+            if (1..=attached).all(|id| detached.iter()
+                .any(|(parent, params)| parent.is_none() && params["sessionId"] == format!("tab-sess-{id}"))) {
+                break;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+        }
+    }).await.expect("completed observations and validations must release every parent CDP session");
+}
