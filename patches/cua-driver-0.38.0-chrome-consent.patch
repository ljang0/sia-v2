diff --git a/libs/cua-driver/rust/crates/platform-macos/src/ax/window_point.rs b/libs/cua-driver/rust/crates/platform-macos/src/ax/window_point.rs
new file mode 100644
index 0000000..c22108d
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/window_point.rs
@@ -0,0 +1,365 @@
+//! Coordinate delivery within one freshly owned native window or attached sheet.
+//!
+//! Remote Open/Save panels can be attached sheets or standalone windows. The
+//! app's point hit-test may miss either. Resolve only the caller's screenshot
+//! point under the focused AX root that maps to the exact requested window;
+//! never search by label or expose a semantic target to the model.
+
+pub(crate) mod popup;
+
+use core_foundation::base::{CFEqual, CFRelease, CFRetain, CFTypeRef};
+
+use super::bindings::{
+    copy_action_names, copy_bool_attr, copy_children_checked, copy_element_attr, copy_string_attr,
+    element_screen_rect, is_attribute_settable, AXUIElementCreateApplication, AXUIElementRef,
+};
+use super::exact_target::{element_window_id, owning_window_id};
+use super::snapshot::RetainedElement;
+
+const MAX_NODES: usize = 256;
+const MAX_DEPTH: usize = 16;
+
+fn contains(rect: [f64; 4], x: f64, y: f64) -> bool {
+    let [left, top, width, height] = rect;
+    rect.iter().all(|n| n.is_finite())
+        && x.is_finite()
+        && y.is_finite()
+        && width > 0.0
+        && height > 0.0
+        && x >= left
+        && y >= top
+        && x < left + width
+        && y < top + height
+}
+
+// Native AppKit scroll content is clipped to its scroll viewport. Popup
+// surfaces are resolved separately before this walk. Do not generalize this
+// pruning to groups or rows: their descendants can extend beyond their frame.
+// https://developer.apple.com/documentation/appkit/nsclipview
+fn clipped_outside_point(role: Option<&str>, rect: Option<[f64; 4]>, x: f64, y: f64) -> bool {
+    role == Some("AXScrollArea")
+        && rect.is_some_and(|rect| {
+            let valid = rect.iter().all(|v| v.is_finite()) && rect[2] > 0.0 && rect[3] > 0.0;
+            valid && x.is_finite() && y.is_finite() && !contains(rect, x, y)
+        })
+}
+
+/// Return one candidate only after the complete bounded scan. Ambiguity or
+/// truncation must not turn the first match into an authorized target.
+fn unique_bounded<T>(root: T, mut inspect: impl FnMut(&T) -> Option<(bool, Vec<T>)>) -> Option<T> {
+    let mut stack = vec![(root, 0)];
+    let mut selected = None;
+    let mut visited = 0;
+    while let Some((element, depth)) = stack.pop() {
+        visited += 1;
+        let (candidate, children) = inspect(&element)?;
+        if (depth == MAX_DEPTH && !children.is_empty())
+            || visited + stack.len() + children.len() > MAX_NODES
+        {
+            return None;
+        }
+        if candidate {
+            if selected.is_some() {
+                return None;
+            }
+            selected = Some(element);
+        }
+        stack.extend(children.into_iter().map(|child| (child, depth + 1)));
+    }
+    selected
+}
+
+unsafe fn adopt(element: AXUIElementRef) -> RetainedElement {
+    let retained = RetainedElement::retain(element as usize);
+    CFRelease(element as CFTypeRef);
+    retained
+}
+
+fn root_matches(role: Option<&str>, owner: Option<u32>, requested: u32) -> bool {
+    matches!(role, Some("AXWindow" | "AXSheet")) && owner == Some(requested)
+}
+
+unsafe fn focused_root(pid: i32, window_id: u32) -> Option<RetainedElement> {
+    let app = AXUIElementCreateApplication(pid);
+    if app.is_null() {
+        return None;
+    }
+    let focused = copy_element_attr(app, "AXFocusedWindow");
+    CFRelease(app as CFTypeRef);
+    let sheet = adopt(focused?);
+    let ptr = sheet.as_ptr() as AXUIElementRef;
+    root_matches(
+        copy_string_attr(ptr, "AXRole").as_deref(),
+        owning_window_id(ptr),
+        window_id,
+    )
+    .then_some(sheet)
+}
+
+/// Geometry-only host proof. A remote sheet must have the requested canonical
+/// owner; a distinct WindowServer record, when available, must agree with AX.
+pub(crate) fn focused_sheet_geometry(
+    pid: i32,
+    window_id: u32,
+) -> anyhow::Result<Option<crate::capture::frame::Sheet>> {
+    use crate::capture::frame::{Rect, Sheet};
+    unsafe {
+        let Some(sheet) = focused_root(pid, window_id) else {
+            return Ok(None);
+        };
+        let ptr = sheet.as_ptr() as AXUIElementRef;
+        // A standalone panel is already the parent capture surface; only an
+        // attached sheet contributes a separate sheet geometry record.
+        if copy_string_attr(ptr, "AXRole").as_deref() != Some("AXSheet") {
+            return Ok(None);
+        }
+        let raw_id = super::bindings::ax_get_window_id(ptr)
+            .ok_or_else(|| anyhow::anyhow!("attached sheet has no window identity"))?;
+        let [x, y, width, height] = element_screen_rect(ptr)
+            .ok_or_else(|| anyhow::anyhow!("attached sheet has no geometry"))?;
+        let bounds = Rect {
+            x,
+            y,
+            width,
+            height,
+        };
+        anyhow::ensure!(bounds.valid(), "invalid attached sheet bounds");
+        if raw_id != window_id {
+            let actual = crate::windows::window_bounds_by_id(raw_id)
+                .ok_or_else(|| anyhow::anyhow!("attached sheet disappeared"))?;
+            anyhow::ensure!(
+                bounds.near(Rect::from(&actual)),
+                "sheet AX and WindowServer bounds disagree"
+            );
+        }
+        Ok(Some(Sheet {
+            window_id: raw_id,
+            bounds,
+        }))
+    }
+}
+
+pub(crate) unsafe fn actionable_at(
+    element: AXUIElementRef,
+    window_id: u32,
+    x: f64,
+    y: f64,
+    focus_only: bool,
+) -> bool {
+    element_screen_rect(element).is_some_and(|rect| contains(rect, x, y))
+        && element_window_id(element) == Some(window_id)
+        && copy_bool_attr(element, "AXEnabled") == Some(true)
+        && copy_bool_attr(element, "AXHidden") != Some(true)
+        && copy_bool_attr(element, "AXVisible") != Some(false)
+        && if focus_only {
+            is_attribute_settable(element, "AXFocused")
+        } else {
+            copy_action_names(element)
+                .iter()
+                .any(|action| action == "AXPress")
+        }
+}
+
+/// Called only after the exact-window background gate, for an unmodified
+/// single left click or focus whose application-level lookup found no usable target.
+/// The model still chooses screenshot coordinates; AX is only the delivery backend.
+///
+/// # Safety
+/// Caller must release the returned +1 element and keep the exact-window lease
+/// through dispatch. No cached tree or element reference may be supplied here.
+pub unsafe fn element_at_point(
+    pid: i32,
+    window_id: u32,
+    x: f64,
+    y: f64,
+    focus_only: bool,
+) -> Option<AXUIElementRef> {
+    let sheet = focused_root(pid, window_id)?;
+    let root = popup::root_at_point(pid, window_id, x, y)
+        .ok()?
+        .unwrap_or_else(|| sheet.clone());
+    let candidate = unique_bounded(root, |element| {
+        let ptr = element.as_ptr() as AXUIElementRef;
+        if clipped_outside_point(
+            copy_string_attr(ptr, "AXRole").as_deref(),
+            element_screen_rect(ptr),
+            x,
+            y,
+        ) {
+            return Some((false, Vec::new()));
+        }
+        Some((
+            actionable_at(ptr, window_id, x, y, focus_only),
+            copy_children_checked(ptr)?
+                .into_iter()
+                .map(|child| adopt(child))
+                .collect(),
+        ))
+    })?;
+    // The panel may close or change while AX RPCs run. Recheck both the root
+    // identity and candidate immediately before handing it to click dispatch.
+    let current = focused_root(pid, window_id)?;
+    let ptr = candidate.as_ptr() as AXUIElementRef;
+    if CFEqual(current.as_ptr() as CFTypeRef, sheet.as_ptr() as CFTypeRef) == 0
+        || !actionable_at(ptr, window_id, x, y, focus_only)
+    {
+        return None;
+    }
+    CFRetain(ptr as CFTypeRef);
+    Some(ptr)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn accepts_only_the_requested_window_or_its_attached_sheet() {
+        for role in ["AXWindow", "AXSheet"] {
+            assert!(root_matches(Some(role), Some(7), 7));
+            assert!(!root_matches(Some(role), Some(8), 7));
+            assert!(!root_matches(Some(role), None, 7));
+        }
+        for role in [None, Some("AXApplication"), Some("AXGroup")] {
+            assert!(!root_matches(role, Some(7), 7));
+        }
+    }
+
+    #[test]
+    fn only_the_requested_point_is_selected() {
+        let rects = [
+            [0.0, 0.0, 100.0, 100.0],
+            [10.0, 10.0, 20.0, 20.0],
+            [40.0, 10.0, 20.0, 20.0],
+        ];
+        assert_eq!(
+            unique_bounded(0, |i| Some((
+                *i > 0 && contains(rects[*i], 15.0, 15.0),
+                if *i == 0 { vec![1, 2] } else { vec![] }
+            ))),
+            Some(1)
+        );
+        assert_eq!(
+            unique_bounded(0, |i| Some((
+                *i > 0 && contains(rects[*i], 90.0, 90.0),
+                if *i == 0 { vec![1, 2] } else { vec![] }
+            ))),
+            None
+        );
+    }
+
+    #[test]
+    fn a_large_clipped_file_list_cannot_hide_a_sheet_button() {
+        // The requested Save button lies below the scroll viewport. Walking
+        // its thousand off-point file rows previously exhausted MAX_NODES.
+        let resolve = |x, y| {
+            unique_bounded(0, |i| {
+                if *i == 0 {
+                    return Some((false, vec![1, 2]));
+                }
+                if *i == 1 {
+                    return Some((
+                        false,
+                        if clipped_outside_point(
+                            Some("AXScrollArea"),
+                            Some([0.0, 0.0, 100.0, 100.0]),
+                            x,
+                            y,
+                        ) {
+                            vec![]
+                        } else {
+                            (3..1003).collect()
+                        },
+                    ));
+                }
+                Some((*i == 2, vec![]))
+            })
+        };
+        assert_eq!(resolve(50.0, 150.0), Some(2));
+        // A point inside the large region still cannot bypass scan limits.
+        assert_eq!(resolve(50.0, 50.0), None);
+    }
+
+    #[test]
+    fn only_a_proven_scroll_viewport_can_clip_the_scan() {
+        let rect = Some([0.0, 0.0, 100.0, 100.0]);
+        assert!(clipped_outside_point(
+            Some("AXScrollArea"),
+            rect,
+            50.0,
+            150.0
+        ));
+        for role in [None, Some("AXGroup"), Some("AXRow"), Some("AXMenu")] {
+            assert!(!clipped_outside_point(role, rect, 50.0, 150.0));
+        }
+        for invalid in [None, Some([0.0, 0.0, f64::NAN, 100.0]), Some([0.0; 4])] {
+            assert!(!clipped_outside_point(
+                Some("AXScrollArea"),
+                invalid,
+                50.0,
+                150.0
+            ));
+        }
+        assert!(!clipped_outside_point(
+            Some("AXScrollArea"),
+            rect,
+            f64::NAN,
+            150.0
+        ));
+        assert!(!clipped_outside_point(
+            Some("AXScrollArea"),
+            rect,
+            50.0,
+            50.0
+        ));
+    }
+
+    #[test]
+    fn overlapping_actionable_controls_are_ambiguous() {
+        assert_eq!(
+            unique_bounded(0, |i| Some((
+                *i > 0,
+                if *i == 0 { vec![1, 2] } else { vec![] }
+            ))),
+            None
+        );
+    }
+
+    #[test]
+    fn truncation_never_returns_an_early_candidate() {
+        assert_eq!(
+            unique_bounded(0, |i| Some((
+                *i == 0,
+                if *i == 0 {
+                    (1..=MAX_NODES).collect()
+                } else {
+                    vec![]
+                }
+            ))),
+            None
+        );
+        assert_eq!(unique_bounded(0, |i| Some((*i == 0, vec![i + 1]))), None);
+    }
+
+    #[test]
+    fn unreadable_subtree_cannot_prove_uniqueness() {
+        assert_eq!(
+            unique_bounded(0, |i| if *i == 0 { Some((true, vec![1])) } else { None }),
+            None
+        );
+    }
+
+    #[test]
+    fn cycles_are_bounded() {
+        assert_eq!(unique_bounded(0, |_| Some((false, vec![0]))), None);
+    }
+
+    #[test]
+    fn invalid_and_edge_coordinates_do_not_hit() {
+        assert!(!contains([0.0, 0.0, 10.0, 10.0], 10.0, 5.0));
+        assert!(!contains([0.0, 0.0, 10.0, 10.0], -1.0, 5.0));
+        assert!(!contains([0.0, 0.0, 10.0, 10.0], f64::NAN, 5.0));
+        assert!(!contains([0.0, 0.0, f64::INFINITY, 10.0], 5.0, 5.0));
+        assert!(!contains([0.0, 0.0, -10.0, 10.0], 5.0, 5.0));
+    }
