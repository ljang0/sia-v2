+//! AppKit menu commands belong to the current document or its attached sheet.
+//! Keep raw modal identity as well as ownership: replacing/dismissing a sheet
+//! during lookup must invalidate the command even when its parent is unchanged.
+
+use crate::ax::{
+    bindings::{ax_get_window_id, copy_element_attr, copy_string_attr, AXUIElementRef},
+    exact_target::owning_window_id,
+};
+use core_foundation::base::{CFRelease, CFTypeRef};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Window {
+    raw: u32,
+    owner: u32,
+    sheet: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct MenuContext {
+    focused: Window,
+    main: Window,
+}
+
+impl MenuContext {
+    pub(super) fn is_modal(self) -> bool {
+        self.focused.sheet
+    }
+
+    fn bind(requested: u32, focused: Option<Window>, main: Option<Window>) -> Option<Self> {
+        let (focused, main) = (focused?, main?);
+        // Main must still be this exact document. Shared process identity alone
+        // is insufficient. Only a freshly owned AXSheet may differ in raw ID.
+        (main.raw == requested
+            && main.owner == requested
+            && !main.sheet
+            && focused.owner == requested
+            && (focused.raw == requested || focused.sheet))
+            .then_some(Self { focused, main })
+    }
+}
+
+unsafe fn window(app: AXUIElementRef, name: &str) -> Option<Window> {
+    let element = copy_element_attr(app, name)?;
+    let result = (|| {
+        let role = copy_string_attr(element, "AXRole")?;
+        if role != "AXWindow" && role != "AXSheet" {
+            return None;
+        }
+        Some(Window {
+            raw: ax_get_window_id(element)?,
+            owner: owning_window_id(element)?,
+            sheet: role == "AXSheet",
+        })
+    })();
+    CFRelease(element as CFTypeRef);
+    result
+}
+
+pub(super) unsafe fn read(
+    app: AXUIElementRef,
+    requested: u32,
+) -> Result<MenuContext, (Option<u32>, Option<u32>)> {
+    let focused = window(app, "AXFocusedWindow");
+    let main = window(app, "AXMainWindow");
+    MenuContext::bind(requested, focused, main).ok_or((focused.map(|w| w.raw), main.map(|w| w.raw)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn document(id: u32) -> Window {
+        Window {
+            raw: id,
+            owner: id,
+            sheet: false,
+        }
+    }
+    fn sheet(raw: u32, owner: u32) -> Window {
+        Window {
+            raw,
+            owner,
+            sheet: true,
+        }
+    }
+
+    #[test]
+    fn accepts_exact_document_and_its_attached_sheet() {
+        let doc = document(7);
+        assert!(!MenuContext::bind(7, Some(doc), Some(doc))
+            .unwrap()
+            .is_modal());
+        assert!(MenuContext::bind(7, Some(sheet(9, 7)), Some(doc))
+            .unwrap()
+            .is_modal());
+    }
+
+    #[test]
+    fn rejects_siblings_unowned_sheets_and_unknown_context() {
+        let doc = Some(document(7));
+        for (focused, main) in [
+            (Some(document(8)), doc),
+            (doc, Some(document(8))),
+            (Some(sheet(9, 8)), doc),
+            (Some(sheet(9, 9)), doc),
+            (Some(document(9)), doc),
+            (doc, Some(sheet(9, 7))),
+            (None, doc),
+            (doc, None),
+            (None, None),
+        ] {
+            assert!(MenuContext::bind(7, focused, main).is_none());
+        }
+    }
+
+    #[test]
+    fn modal_replacement_or_dismissal_changes_dispatch_context() {
+        let doc = Some(document(7));
+        let before = MenuContext::bind(7, Some(sheet(9, 7)), doc).unwrap();
+        assert_ne!(Some(before), MenuContext::bind(7, Some(sheet(10, 7)), doc));
+        assert_ne!(Some(before), MenuContext::bind(7, doc, doc));
+        assert_eq!(Some(before), MenuContext::bind(7, Some(sheet(9, 7)), doc));
+    }
+}
