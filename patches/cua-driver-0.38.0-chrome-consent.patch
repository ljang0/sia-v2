+        WindowBounds {
+            x: 100.0,
+            y: 580.0,
+            width: 500.0,
+            height: 500.0,
+        }
+    }
+
+    #[test]
+    fn backing_scale_detects_retina_capture() {
+        let b = parent_bounds();
