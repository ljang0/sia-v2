--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/main_thread.rs
@@ -0,0 +1,98 @@
+//! Self-process AX mutations execute AppKit code locally and must run on
+//! its main queue. Remote AX calls retain their caller thread.
+use std::{
+    ffi::c_void,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc::{self, SyncSender},
+        Arc,
+    },
+    time::Duration,
+};
+
+struct Request<F, T> {
+    work: F,
+    tx: SyncSender<T>,
+    cancelled: Arc<AtomicBool>,
+}
+
+impl<F: FnOnce() -> T, T> Request<F, T> {
+    fn run(self) {
+        if !self.cancelled.load(Ordering::Acquire) {
+            let _ = self.tx.send((self.work)());
+        }
+    }
+}
+
+#[link(name = "System", kind = "framework")]
+extern "C" {
+    static _dispatch_main_q: u8;
+    fn dispatch_async_f(
+        queue: *const c_void,
+        context: *mut c_void,
+        work: unsafe extern "C" fn(*mut c_void),
+    );
+}
+
+unsafe extern "C" fn run<F: FnOnce() -> T, T>(context: *mut c_void) {
+    let request = unsafe { Box::from_raw(context.cast::<Request<F, T>>()) };
+    request.run();
+}
+
+/// Wait at most five seconds for a self-process mutation. A queued request
+/// that has not started is cancelled on timeout, preventing a late focus
+/// change after the caller has already reported failure.
+pub(crate) fn for_process<F, T>(pid: i32, work: F) -> Result<T, String>
+where
+    F: FnOnce() -> T + Send + 'static,
+    T: Send + 'static,
+{
+    if pid != std::process::id() as i32 || objc2_foundation::MainThreadMarker::new().is_some() {
+        return Ok(work());
+    }
+    let (tx, rx) = mpsc::sync_channel(1);
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let request = Box::new(Request {
+        work,
+        tx,
+        cancelled: Arc::clone(&cancelled),
+    });
+    unsafe {
+        dispatch_async_f(
+            &raw const _dispatch_main_q as *const c_void,
+            Box::into_raw(request).cast::<c_void>(),
+            run::<F, T>,
+        );
+    }
+    rx.recv_timeout(Duration::from_secs(5)).map_err(|error| {
+        cancelled.store(true, Ordering::Release);
+        format!("embedded host main-queue request failed: {error}")
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn cancelled_queued_work_never_changes_focus_later() {
+        let (tx, rx) = mpsc::sync_channel(1);
+        Request {
+            work: || panic!("cancelled mutation ran"),
+            tx,
+            cancelled: Arc::new(AtomicBool::new(true)),
+        }
+        .run();
+        assert!(rx.try_recv().is_err());
+    }
+    #[test]
+    fn live_request_returns_its_actual_result() {
+        let (tx, rx) = mpsc::sync_channel(1);
+        Request {
+            work: || false,
+            tx,
+            cancelled: Arc::new(AtomicBool::new(false)),
+        }
+        .run();
+        assert!(!rx.recv().unwrap());
+    }
+}
