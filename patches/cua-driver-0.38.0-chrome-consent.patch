+// A real signed-app task followed a target=_blank link and activated Chrome.
+// Read the live bound node before dispatch; do not rewrite the page or replace
+// a click with navigation. The caller can choose a separate, authorized navigation.
+const BACKGROUND_LINK_NEW_CONTEXT: &str = r#"function siaNewContext() {
+  const element = this.nodeType === 1 ? this : this.parentElement;
+  if (!element) return null;
+  // Chromium rejects Element.closest in throwOnSideEffect evaluation.
+  // These DOM reads are admitted; retain the restriction and bound the walk.
+  let anchor = element;
+  let remaining = 512;
+  while (anchor) {
+    if (--remaining === 0) return null;
+    const name = anchor.localName;
+    if ((name === 'a' || name === 'area') && anchor.getAttribute('href') !== null) break;
+    anchor = anchor.parentElement;
+  }
+  if (!anchor) return false;
+  const target = (anchor.getAttribute('target') ||
+    anchor.ownerDocument.querySelector('base[target]')?.getAttribute('target') || '').toLowerCase();
+  return target !== '' && target !== '_self';
+}"#;
+
+async fn background_link_opens_context(
+    conn: &CdpConnection,
+    cdp: &str,
+    backend: i64,
+) -> Result<bool, BrowserRefusal> {
+    let unavailable = || {
+        BrowserRefusal::new(
+            BrowserRefusalCode::BrowserActionUnavailable,
+            "the link's browsing context could not be checked; no input was sent",
+        )
+    };
+    let resolved = conn
+        .call(
+            Some(cdp),
+            "DOM.resolveNode",
+            json!({ "backendNodeId": backend }),
+        )
+        .await
+        .map_err(|_| unavailable())?;
+    let object = resolved
+        .get("object")
+        .and_then(|v| v.get("objectId"))
+        .and_then(Value::as_str)
+        .ok_or_else(unavailable)?;
+    let result = conn
+        .call(
+            Some(cdp),
+            "Runtime.callFunctionOn",
+            json!({
+                "objectId": object,
+                "functionDeclaration": BACKGROUND_LINK_NEW_CONTEXT,
+                "returnByValue": true,
+                "silent": true,
+                "throwOnSideEffect": true,
+            }),
+        )
+        .await;
+    let _ = conn
+        .call(
+            Some(cdp),
+            "Runtime.releaseObject",
+            json!({ "objectId": object }),
+        )
+        .await;
+    let result = result.map_err(|_| unavailable())?;
+    if result.get("exceptionDetails").is_some() {
+        return Err(unavailable());
+    }
+    result
+        .get("result")
+        .and_then(|v| v.get("value"))
+        .and_then(Value::as_bool)
+        .ok_or_else(unavailable)
+}
+
+// Security hit-test of the model-chosen point. Never changes the point or returns a DOM target.
+pub(super) async fn guard_background_point(
+    conn: &CdpConnection, cdp: &str, x: f64, y: f64,
+) -> Result<(), BrowserRefusal> {
+    let unavailable = || BrowserRefusal::new(BrowserRefusalCode::BrowserActionUnavailable,
+        "the chosen point's browsing context could not be checked; no input was sent");
+    if !x.is_finite() || !y.is_finite() || x < 0.0 || y < 0.0 || x > i32::MAX as f64 || y > i32::MAX as f64 {
+        return Err(unavailable());
+    }
+    let hit = conn.call(Some(cdp), "DOM.getNodeForLocation", json!({
+        "x": x.floor() as i32, "y": y.floor() as i32,
+        "includeUserAgentShadowDOM": true,
+    })).await.map_err(|_| unavailable())?;
+    let backend = hit.get("backendNodeId").and_then(Value::as_i64)
+        .filter(|id| *id > 0).ok_or_else(unavailable)?;
+    if background_link_opens_context(conn, cdp, backend).await? {
+        return Err(BrowserRefusal::new(BrowserRefusalCode::BrowserNewContextRefused,
+            "the chosen point opens another browsing context; no background input was sent"));
+    }
+    Ok(())
+}
