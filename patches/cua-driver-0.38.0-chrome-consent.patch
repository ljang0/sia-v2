+//! Compose separately captured, exactly owned surfaces in one screen coordinate frame.
+//! Every layer keeps its own completed-sample geometry. The caller revalidates the
+//! complete surface set after capture; no model-visible semantic data is involved.
+use super::frame::{CapturedWindow, Geometry, Rect, Surface};
+use image::{imageops, RgbaImage};
+
+fn place(
+    canvas: &mut RgbaImage,
+    layer: &CapturedWindow,
+    source: Rect,
+    scale: f64,
+) -> anyhow::Result<()> {
+    let g = &layer.geometry;
+    let image = image::load_from_memory(&layer.png)?.to_rgba8();
+    anyhow::ensure!(
+        image.width() == g.width && image.height() == g.height,
+        "layer pixels and geometry disagree"
+    );
+    let c = g.content;
+    let (x, y, right, bottom) = (
+        c.x.round() as u32,
+        c.y.round() as u32,
+        (c.x + c.width).round() as u32,
+        (c.y + c.height).round() as u32,
+    );
+    let w = right.saturating_sub(x);
+    let h = bottom.saturating_sub(y);
+    anyhow::ensure!(
+        c.valid()
+            && c.x >= 0.0
+            && c.y >= 0.0
+            && w > 0
+            && h > 0
+            && x.checked_add(w).is_some_and(|v| v <= image.width())
+            && y.checked_add(h).is_some_and(|v| v <= image.height()),
+        "invalid layer crop"
+    );
+    let crop = imageops::crop_imm(&image, x, y, w, h).to_image();
+    let rect = g.surface.source();
+    // Round shared edges, not origin and size independently: at fractional
+    // scales a layer ending on the union edge must end on the canvas edge.
+    let dx = ((rect.x - source.x) * scale).round() as i64;
+    let dy = ((rect.y - source.y) * scale).round() as i64;
+    let right = ((rect.x + rect.width - source.x) * scale).round() as i64;
+    let bottom = ((rect.y + rect.height - source.y) * scale).round() as i64;
+    let width = super::rounded_pixel_dim((right - dx) as f64, "popup layer width")?;
+    let height = super::rounded_pixel_dim((bottom - dy) as f64, "popup layer height")?;
+    anyhow::ensure!(
+        dx >= 0
+            && dy >= 0
+            && dx + i64::from(width) <= i64::from(canvas.width())
+            && dy + i64::from(height) <= i64::from(canvas.height()),
+        "layer lies outside composite"
+    );
+    let resized = imageops::resize(&crop, width, height, imageops::FilterType::Triangle);
+    imageops::overlay(canvas, &resized, dx, dy);
+    Ok(())
+}
+
+pub(super) fn compose(
+    parent: CapturedWindow,
+    popups: Vec<CapturedWindow>,
+    surface: Surface,
+) -> anyhow::Result<CapturedWindow> {
+    anyhow::ensure!(
+        !surface.popups.is_empty()
+            && surface.popups.len() <= 2
+            && surface.popups.len() == popups.len(),
+        "invalid popup surface count"
+    );
+    let mut base = surface.clone();
+    base.popups.clear();
+    anyhow::ensure!(
+        parent.geometry.surface == base,
+        "document changed before popup capture"
+    );
+    for (proof, layer) in surface.popups.iter().zip(&popups) {
+        let actual = &layer.geometry.surface;
+        anyhow::ensure!(
+            actual.window_id == proof.window_id
+                && actual.pid == proof.pid
+                && actual.parent.near(proof.bounds)
+                && actual.sheet.is_none()
+                && actual.popups.is_empty(),
+            "popup capture does not match its owned surface"
+        );
+    }
+    let source = surface.source();
+    // Retain the parent sample's measured scale instead of upsampling its text.
+    let scale = parent.geometry.pixels_per_point;
+    anyhow::ensure!(
+        scale.is_finite() && scale > 0.0 && scale <= 2.01,
+        "invalid composite scale"
+    );
+    let width = super::rounded_pixel_dim(source.width * scale, "popup composite width")?;
+    let height = super::rounded_pixel_dim(source.height * scale, "popup composite height")?;
+    anyhow::ensure!(
+        u64::from(width) * u64::from(height) <= 32_000_000,
+        "popup composite is too large"
+    );
+    let mut canvas = RgbaImage::new(width, height);
+    place(&mut canvas, &parent, source, scale)?;
+    for layer in &popups {
+        place(&mut canvas, layer, source, scale)?;
+    }
