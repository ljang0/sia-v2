@@ -0,0 +1,156 @@
+//! One completed sample supplies both pixels and ScreenCaptureKit geometry.
+//! A screenshot-manager image plus a separate stream sample is not a valid pair.
+use super::frame::{CapturedWindow, Geometry, Surface};
+use core_foundation::{
+    array::{CFArrayGetCount, CFArrayGetValueAtIndex, CFArrayRef},
+    base::{CFGetTypeID, CFRetain, CFTypeRef},
+    dictionary::{CFDictionaryGetTypeID, CFDictionaryGetValue, CFDictionaryRef},
+    number::{kCFNumberSInt64Type, CFNumberGetTypeID, CFNumberGetValue, CFNumberRef},
+    string::CFStringRef,
+};
+use screencapturekit::prelude::*;
+use std::{ffi::c_void, sync::mpsc, time::Duration};
+#[link(name = "CoreMedia", kind = "framework")]
+extern "C" {
+    fn CMSampleBufferGetSampleAttachmentsArray(buffer: *mut c_void, create: bool) -> CFArrayRef;
+}
+#[link(name = "ScreenCaptureKit", kind = "framework")]
+extern "C" {
+    static SCStreamFrameInfoStatus: CFStringRef;
+}
+
+/// The pinned Swift bridge casts NSNumber directly to SCFrameStatus and returns
+/// None on real frames. Read the documented numeric attachment with CF type checks.
+unsafe fn numeric_status(value: CFTypeRef) -> Option<i64> {
+    if value.is_null() || CFGetTypeID(value) != CFNumberGetTypeID() {
+        return None;
+    }
+    let mut status = 0i64;
+    CFNumberGetValue(
+        value as CFNumberRef,
+        kCFNumberSInt64Type,
+        &mut status as *mut _ as *mut c_void,
+    )
+    .then_some(status)
+}
+fn complete(sample: &CMSampleBuffer) -> bool {
+    if !sample.is_valid() || !sample.data_is_ready() {
+        return false;
+    }
+    unsafe {
+        let array = CMSampleBufferGetSampleAttachmentsArray(sample.as_ptr(), false);
+        if array.is_null() || CFArrayGetCount(array) != 1 {
+            return false;
+        }
+        let dict = CFArrayGetValueAtIndex(array, 0);
+        if dict.is_null() || CFGetTypeID(dict) != CFDictionaryGetTypeID() {
+            return false;
+        }
+        numeric_status(CFDictionaryGetValue(
+            dict as CFDictionaryRef,
+            SCStreamFrameInfoStatus as *const c_void,
+        )) == Some(0)
+    }
+}
+pub(super) fn capture(
+    plan: &super::WindowCapturePlan,
+    surface: Surface,
+) -> anyhow::Result<CapturedWindow> {
+    let (tx, rx) = mpsc::sync_channel(1);
+    let mut stream = SCStream::new(&plan.filter, &plan.config);
+    anyhow::ensure!(
+        stream
+            .add_output_handler(
+                move |sample: CMSampleBuffer, kind| {
+                    if kind == SCStreamOutputType::Screen && complete(&sample) {
+                        let _ = tx.try_send(sample);
+                    }
+                },
+                SCStreamOutputType::Screen
+            )
+            .is_some(),
+        "could not attach window capture output"
+    );
+    stream
+        .start_capture()
+        .map_err(|e| anyhow::anyhow!("start window capture: {e}"))?;
+    let received = rx.recv_timeout(Duration::from_millis(1000));
+    let stopped = stream.stop_capture();
+    let sample = received.map_err(|e| anyhow::anyhow!("no completed window frame: {e}"))?;
+    stopped.map_err(|e| anyhow::anyhow!("stop window capture: {e}"))?;
+    let info = sample
+        .frame_info()
+        .ok_or_else(|| anyhow::anyhow!("window frame has no geometry"))?;
+    let (png, width, height) = sample_png(&sample)?;
+    let geometry = Geometry::from_sample(
+        surface,
+        width,
+        height,
+        info.screen_rect
+            .ok_or_else(|| anyhow::anyhow!("missing sample screen rect"))?
+            .into(),
+        info.content_rect
+            .ok_or_else(|| anyhow::anyhow!("missing sample content rect"))?
+            .into(),
+        info.scale_factor
+            .ok_or_else(|| anyhow::anyhow!("missing sample backing scale"))?,
+        info.content_scale
+            .ok_or_else(|| anyhow::anyhow!("missing sample content scale"))?,
+    )?;
+    geometry.surface.ensure_base_current()?;
+    Ok(CapturedWindow { png, geometry })
+}
+fn sample_png(sample: &CMSampleBuffer) -> anyhow::Result<(Vec<u8>, u32, u32)> {
+    let ptr = sample.image_buffer_ptr();
+    anyhow::ensure!(!ptr.is_null(), "completed frame has no pixel buffer");
+    // image_buffer_ptr is borrowed from sample. The wrapper consumes a +1 ref.
+    let buffer =
+        unsafe { screencapturekit::cv::CVPixelBuffer::from_ptr(CFRetain(ptr) as *mut c_void) };
+    anyhow::ensure!(
+        buffer.pixel_format() == 0x42475241,
+        "window frame is not BGRA"
+    );
+    let width = super::checked_image_dim(buffer.width(), "sample width")?;
+    let height = super::checked_image_dim(buffer.height(), "sample height")?;
+    let lock = buffer
+        .lock_read_only()
+        .map_err(|e| anyhow::anyhow!("pixel buffer lock: {e}"))?;
+    let row_bytes = width as usize * 4;
+    anyhow::ensure!(
+        !lock.base_address().is_null() && lock.bytes_per_row() >= row_bytes,
+        "invalid BGRA layout"
+    );
+    let mut rgba = Vec::with_capacity(row_bytes * height as usize);
+    for y in 0..height as usize {
+        // Locked BGRA buffer owns height rows with at least width*4 bytes each.
+        let row = unsafe {
+            std::slice::from_raw_parts(lock.base_address().add(y * lock.bytes_per_row()), row_bytes)
+        };
+        for pixel in row.chunks_exact(4) {
+            rgba.extend_from_slice(&[pixel[2], pixel[1], pixel[0], pixel[3]]);
+        }
+    }
+    anyhow::ensure!(
+        super::unpremultiply_rgba(&mut rgba),
+        "window frame is transparent"
+    );
+    Ok((
+        cua_driver_core::image_utils::encode_rgba_to_png(&rgba, width, height)?,
+        width,
+        height,
+    ))
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use core_foundation::{base::TCFType, number::CFNumber, string::CFString};
+    #[test]
+    fn status_requires_a_numeric_complete_attachment() {
+        unsafe {
+            assert_eq!(numeric_status(std::ptr::null()), None);
+            assert_eq!(numeric_status(CFString::new("0").as_CFTypeRef()), None);
+            assert_eq!(numeric_status(CFNumber::from(0i64).as_CFTypeRef()), Some(0));
+            assert_eq!(numeric_status(CFNumber::from(1i64).as_CFTypeRef()), Some(1));
+        }
+    }
+}
