+        let token = super::visual_observation_token("document", &metrics).unwrap();
+        for field in ["pageX", "pageY", "offsetX", "offsetY", "clientWidth", "clientHeight", "scale"] {
+            let mut missing = metrics.clone();
+            missing["cssVisualViewport"].as_object_mut().unwrap().remove(field);
+            assert!(super::visual_observation_token("document", &missing).is_err(), "{field}");
+            let mut malformed = metrics.clone();
