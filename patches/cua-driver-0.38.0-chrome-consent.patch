+#[tokio::test]
+async fn background_new_context_refuses_before_input_and_preserves_foreground_choice() {
+    for route in ["trusted", "dom_event"] {
+        for new_context in [json!(true), Value::Null, json!(false)] {
+            let f = fixture().await;
+            let (target, tab) = bind(&f).await;
+            let snap = snapshot(&f, &target, &tab).await;
+            let node = ref_of(&snap, "iframe", "inner-btn");
+            f.state.lock().unwrap().background_new_context = new_context.clone();
+            let result = BrowserClickTool::new(f.engine.clone())
+                .invoke(json!({
+                    "target_id": target, "tab_id": tab, "ref": node, "session": SESSION,
+                    "input_route": route,
+                }))
+                .await;
+            if new_context != json!(false) {
+                let s = structured(&result);
+                let expected = if new_context == json!(true) {
+                    "browser_new_context_refused"
+                } else {
+                    "browser_action_unavailable"
+                };
+                assert_eq!(s["refusal"]["code"], expected, "{s}");
+                assert!(recorded_calls(&f, "Input.dispatchMouseEvent").is_empty());
+                assert!(!f.state.lock().unwrap().dom_click_focused);
+                assert!(recorded_calls(&f, "Emulation.setFocusEmulationEnabled").is_empty());
+                assert!(recorded_calls(&f, "Page.navigate").is_empty());
+            } else {
+                assert!(!result.is_error.unwrap_or(false), "{result:?}");
+            }
+        }
+    }
+    let f = fixture().await;
+    let (target, tab) = bind(&f).await;
+    let snap = snapshot(&f, &target, &tab).await;
+    let node = ref_of(&snap, "iframe", "inner-btn");
+    f.state.lock().unwrap().background_new_context = json!(true);
+    BrowserClickTool::new(f.engine.clone())
+        .invoke(json!({
+            "target_id": target, "tab_id": tab, "ref": node, "session": SESSION,
+            "delivery_mode": "foreground",
+        }))
+        .await;
+    assert_eq!(recorded_calls(&f, "Input.dispatchMouseEvent").len(), 2);
+}
