@@ -0,0 +1,325 @@
+//! A named key at the visually selected page focus, never a DOM focus/setter or OS shortcut.
+use super::engine::{BrowserEngine, ValidatedTab};
+use super::refusal::{BrowserRefusal, BrowserRefusalCode};
+use crate::protocol::ToolResult;
+use serde_json::{json, Value};
+
+// Security-only, side-effect-checked inspection. Returns no text, refs, or focus targets.
+// A page keyboard event may activate a link/form just like a pointer click.
+pub(super) const FOCUSED_KEY_GUARD: &str = r#"((requireEditable, canActivate) => { /* siaVisualKeyGuard */
+  let root = document, field;
+  for (let depth = 0; depth < 32; depth++) {
+    field = root.activeElement;
+    if (!field) return false;
+    if (field.shadowRoot) { root = field.shadowRoot; continue; }
+    if (field.localName === 'iframe' || field.localName === 'frame') {
+      try { root = field.contentDocument; } catch { return false; }
+      if (!root) return false;
+      continue;
+    }
+    if (field.localName === 'input' && /^(password|hidden|file)$/i.test(field.type)) return false;
+    if (/password|one-time-code|cc-|webauthn/i.test(field.getAttribute('autocomplete') || '')) return false;
+    if (field.disabled || field.readOnly) return false;
+    const ownDoc = field.ownerDocument;
+    const base = canActivate ? (ownDoc.querySelector('base[target]')?.getAttribute('target') || '') : '';
+    const other = target => target !== '' && target.toLowerCase() !== '_self';
+    let parent = canActivate ? field : null, remaining = 512;
+    while (parent) {
+      if (--remaining === 0) return false;
+      if ((parent.localName === 'a' || parent.localName === 'area') &&
+          parent.getAttribute('href') !== null && other(parent.getAttribute('target') || base)) return false;
+      parent = parent.parentElement;
+    }
+    const form = field.form;
+    if (form) {
+      if (canActivate && other(field.getAttribute('formtarget') || form.getAttribute('target') || base)) return false;
+      // Includes externally associated controls: Enter may activate a default submitter
+      // outside the form's DOM subtree. No control values or names leave this guard.
+      const controls = form.elements;
+      if (controls.length > 512) return false;
+      for (let index = 0; index < controls.length; index++) {
+        const control = controls[index];
+        if (control.localName === 'input' && control.type === 'password') return false;
+        const target = control.getAttribute('formtarget');
+        if (canActivate && target !== null && other(target || base)) return false;
+      }
+    }
+    if (!requireEditable) return true;
+    return field.localName === 'textarea' ||
+      (field.localName === 'input' && /^(text|search|email|tel|url|number)$/i.test(field.type)) ||
+      field.isContentEditable === true;
+  }
+  return false;
+})"#;
+
+struct VisualKey {
+    key: String,
+    code: String,
+    virtual_code: u32,
+    modifiers: u32,
+    text: Option<String>,
+    command: Option<&'static str>,
+    editable: bool,
+}
+
+fn parse(key: &str, args: &Value) -> Result<VisualKey, &'static str> {
+    let mut modifiers = 0;
+    if let Some(raw) = args.get("modifiers") {
+        let values = raw.as_array().ok_or("modifiers must be an array")?;
+        for modifier in values {
+            let bit = match modifier.as_str() {
+                Some("cmd") => 4,
+                Some("shift") => 8,
+                Some("option") => 1,
+                _ => return Err("this background page shortcut is unavailable"),
+            };
+            if modifiers & bit != 0 {
+                return Err("duplicate key modifier");
+            }
+            modifiers |= bit;
+        }
+    }
+    let key = key.to_ascii_lowercase();
+    let shifted = modifiers & 8 != 0;
+    let base_modifiers = modifiers & !8;
+    if shifted && key == "escape" {
+        return Err("browser-wide shortcuts are unavailable in background page input");
+    }
+    let mut command = None;
+    if base_modifiers != 0 {
+        command =
+            Some(match (base_modifiers, key.as_str(), shifted) {
+                (4, "a", false) => "selectAll",
+                (4, "z", false) => "undo",
+                (4, "z", true) => "redo",
+                (4, "left", false) => "moveToBeginningOfLine",
+                (4, "left", true) => "moveToBeginningOfLineAndModifySelection",
+                (4, "right", false) => "moveToEndOfLine",
+                (4, "right", true) => "moveToEndOfLineAndModifySelection",
+                (4, "up", false) => "moveToBeginningOfDocument",
+                (4, "up", true) => "moveToBeginningOfDocumentAndModifySelection",
+                (4, "down", false) => "moveToEndOfDocument",
+                (4, "down", true) => "moveToEndOfDocumentAndModifySelection",
+                (4, "delete" | "backspace", false) => "deleteToBeginningOfLine",
+                (1, "left", false) => "moveWordLeft",
+                (1, "left", true) => "moveWordLeftAndModifySelection",
+                (1, "right", false) => "moveWordRight",
+                (1, "right", true) => "moveWordRightAndModifySelection",
+                (1, "delete" | "backspace", false) => "deleteWordBackward",
+                _ => return Err(
+                    "clipboard and browser-wide shortcuts are unavailable in background page input",
+                ),
+            });
+    }
+    let (named, code, virtual_code, text, editable) = match key.as_str() {
+        "enter" | "return" => ("Enter".into(), "Enter".into(), 13, Some("\r".into()), false),
+        "tab" => ("Tab".into(), "Tab".into(), 9, None, false),
+        "escape" => ("Escape".into(), "Escape".into(), 27, None, false),
+        "space" => (" ".into(), "Space".into(), 32, Some(" ".into()), false),
+        "delete" | "backspace" => ("Backspace".into(), "Backspace".into(), 8, None, true),
+        "up" => ("ArrowUp".into(), "ArrowUp".into(), 38, None, false),
+        "down" => ("ArrowDown".into(), "ArrowDown".into(), 40, None, false),
+        "left" => ("ArrowLeft".into(), "ArrowLeft".into(), 37, None, false),
+        "right" => ("ArrowRight".into(), "ArrowRight".into(), 39, None, false),
+        "home" => ("Home".into(), "Home".into(), 36, None, false),
+        "end" => ("End".into(), "End".into(), 35, None, false),
+        "pageup" => ("PageUp".into(), "PageUp".into(), 33, None, false),
+        "pagedown" => ("PageDown".into(), "PageDown".into(), 34, None, false),
+        value if value.len() == 1 && value.as_bytes()[0].is_ascii_alphanumeric() => {
+            let byte = value.as_bytes()[0];
+            // Shifted digits need a keyboard-layout contract; type literal text instead.
+            if shifted && byte.is_ascii_digit() {
+                return Err("type the literal symbol instead");
+            }
+            let text = if shifted {
+                value.to_ascii_uppercase()
+            } else {
+                value.into()
+            };
+            let code = if byte.is_ascii_digit() {
+                format!("Digit{value}")
+            } else {
+                format!("Key{}", value.to_ascii_uppercase())
+            };
+            (
+                text.clone(),
+                code,
+                u32::from(byte.to_ascii_uppercase()),
+                Some(text),
+                false,
+            )
+        }
+        _ => return Err("use a supported page key or type literal text"),
+    };
+    Ok(VisualKey {
+        key: named,
+        code,
+        virtual_code,
+        modifiers,
+        text: if base_modifiers == 0 { text } else { None },
+        command,
+        // Cmd+A/Z are page-local even in custom canvas editors. Movement/deletion
+        // shortcuts need an editable caret to avoid browser history commands.
+        editable: editable
+            || (command.is_some() && !(base_modifiers == 4 && matches!(key.as_str(), "a" | "z")))
+            || (shifted && matches!(key.as_str(), "enter" | "return")),
+    })
+}
+
+async fn focus_is_safe(tab: &ValidatedTab, key: &VisualKey) -> bool {
+    let response = tab
+        .conn
+        .call(
+            Some(&tab.cdp_session),
+            "Runtime.evaluate",
+            json!({
+                "expression": format!("({FOCUSED_KEY_GUARD})({}, {})", key.editable, matches!(key.key.as_str(), "Enter" | " ")),
+                "returnByValue": true, "silent": true, "throwOnSideEffect": true,
+            }),
+        )
+        .await;
+    matches!(response, Ok(ref reply) if reply.get("exceptionDetails").is_none() &&
+        reply.pointer("/result/value").and_then(Value::as_bool) == Some(true))
+}
+
+pub(super) async fn deliver(
+    engine: &BrowserEngine,
+    tab: &ValidatedTab,
+    args: &Value,
+    key: &str,
+) -> ToolResult {
+    let key = match parse(key, args) {
+        Ok(key) => key,
+        Err(message) => {
+            return BrowserRefusal::new(BrowserRefusalCode::BrowserActionUnavailable, message)
+                .to_tool_result()
+        }
+    };
+    let Some(token) = args
+        .get("visual_document")
+        .and_then(Value::as_str)
+        .filter(|s| s.len() == 64 && s.bytes().all(|c| c.is_ascii_hexdigit()))
+    else {
+        return BrowserRefusal::new(
+            BrowserRefusalCode::BrowserRefStale,
+            "a fresh visual observation is required for page keys",
+        )
+        .to_tool_result();
+    };
+    if let Err(refusal) = engine.verify_visual_document(tab, Some(token)).await {
+        return refusal.to_tool_result();
+    }
+    if !focus_is_safe(tab, &key).await {
+        return BrowserRefusal::new(BrowserRefusalCode::BrowserActionUnavailable, "the current page focus is protected, unproven or could open another context; no key sent").to_tool_result();
+    }
+    let conn = &tab.conn;
+    let cdp = tab.cdp_session.as_str();
+    // Even a failed focus call may have reached Chrome: always attempt restore.
+    let focused = conn
+        .call(
+            Some(cdp),
+            "Emulation.setFocusEmulationEnabled",
+            json!({"enabled": true}),
+        )
+        .await;
+    let mut refusal = None;
+    let mut uncertain = focused.is_err();
+    if !uncertain {
+        if !focus_is_safe(tab, &key).await {
+            refusal = Some(BrowserRefusal::new(
+                BrowserRefusalCode::BrowserActionUnavailable,
+                "page focus changed to an unproven target; no key sent",
+            ));
+        } else if let Err(changed) = engine.verify_visual_document(tab, Some(token)).await {
+            refusal = Some(changed);
+        } else {
+            let mut event = json!({"type": "keyDown", "key": key.key, "code": key.code,
+                "windowsVirtualKeyCode": key.virtual_code, "modifiers": key.modifiers});
+            if let Some(text) = &key.text {
+                event["text"] = json!(text);
+                event["unmodifiedText"] = json!(text.to_ascii_lowercase());
+            }
+            if let Some(command) = key.command {
+                event["commands"] = json!([command]);
+            }
+            let pressed = conn.call(Some(cdp), "Input.dispatchKeyEvent", event).await;
+            // Release once even if the press acknowledgement was lost. Never replay keyDown.
+            let released = conn
+                .call(
+                    Some(cdp),
+                    "Input.dispatchKeyEvent",
+                    json!({
+                        "type": "keyUp", "key": key.key, "code": key.code,
+                        "windowsVirtualKeyCode": key.virtual_code, "modifiers": key.modifiers,
+                    }),
+                )
+                .await;
+            uncertain = pressed.is_err() || released.is_err();
+        }
+    }
+    let restored = conn
+        .call(
+            Some(cdp),
+            "Emulation.setFocusEmulationEnabled",
+            json!({"enabled": false}),
+        )
+        .await;
+    if uncertain || restored.is_err() {
+        return BrowserRefusal::new(BrowserRefusalCode::BrowserInputIncomplete,
+            "page keyboard delivery or focus cleanup was uncertain; inspect without replaying the key")
+            .with_detail(json!({"retryable": false, "delivery": "unknown"})).to_tool_result();
+    }
+    if let Some(refusal) = refusal {
+        return refusal.to_tool_result();
+    }
+    ToolResult::text("Page key delivered; inspect a fresh screenshot to verify its effect.")
+        .with_structured(
+            json!({"status": "ok", "route": "trusted", "delivery_mode": "background",
+            "target_id": args["target_id"], "tab_id": args["tab_id"], "mode": "focused_key"}),
+        )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn page_key_allowlist_has_no_clipboard_or_browser_global_shortcuts() {
+        for key in ["c", "x", "v", "l", "r", "t", "w", "q", "f", "1"] {
+            for modifier in ["cmd", "ctrl"] {
+                assert!(
+                    parse(key, &json!({"modifiers": [modifier]})).is_err(),
+                    "{modifier}/{key}"
+                );
+            }
+        }
+        assert!(parse("tab", &json!({"modifiers": ["ctrl"]})).is_err());
+        assert!(parse("escape", &json!({"modifiers": ["shift"]})).is_err());
+        assert!(
+            parse("enter", &json!({"modifiers": ["shift"]}))
+                .unwrap()
+                .editable
+        );
+        assert!(!parse("a", &json!({"modifiers": ["cmd"]})).unwrap().editable);
+        assert!(!parse("g", &json!({})).unwrap().editable);
+        assert!(parse("enter", &json!({"modifiers": ["cmd"]})).is_err());
+        assert!(parse("a", &json!({"modifiers": ["cmd", "cmd"]})).is_err());
+        assert!(parse("a", &json!({"modifiers": "cmd"})).is_err());
+        assert_eq!(
+            parse("a", &json!({"modifiers": ["cmd"]})).unwrap().command,
+            Some("selectAll")
+        );
+        assert_eq!(
+            parse("z", &json!({"modifiers": ["cmd", "shift"]}))
+                .unwrap()
+                .command,
+            Some("redo")
+        );
+        assert_eq!(
+            parse("left", &json!({"modifiers": ["option", "shift"]}))
+                .unwrap()
+                .command,
+            Some("moveWordLeftAndModifySelection")
+        );
+        assert_eq!(parse("delete", &json!({})).unwrap().virtual_code, 8);
+    }
+}
