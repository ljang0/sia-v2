+/// Bind the image to CSS viewport state as well as the document. The token remains
+/// host-only: it exposes neither page content nor coordinates to the model.
+fn visual_observation_token(document: &str, metrics: &Value) -> Result<String, BrowserRefusal> {
+    let viewport = metrics.get("cssVisualViewport").ok_or_else(|| {
+        refuse(BrowserRefusalCode::BrowserRefStale, "CSS viewport state could not be proven; capture a fresh screenshot")
+    })?;
+    let mut values = Vec::new();
+    for field in ["pageX", "pageY", "offsetX", "offsetY", "clientWidth", "clientHeight", "scale", "zoom"] {
+        // CDP marks zoom optional. Absence is recorded, never guessed as 1.
+        if field == "zoom" && viewport.get(field).is_none() {
+            values.push(None);
+            continue;
+        }
+        let value = viewport.get(field).and_then(Value::as_f64)
+            .filter(|v| v.is_finite())
+            .ok_or_else(|| refuse(BrowserRefusalCode::BrowserRefStale, "CSS viewport state is incomplete; capture a fresh screenshot"))?;
+        if matches!(field, "clientWidth" | "clientHeight" | "scale" | "zoom") && value <= 0.0 {
+            return Err(refuse(BrowserRefusalCode::BrowserRefStale, "CSS viewport geometry is invalid; capture a fresh screenshot"));
+        }
+        values.push(Some(value));
+    }
+    let encoded = serde_json::to_vec(&(document, values)).expect("finite viewport values serialize");
+    Ok(format!("{:x}", Sha256::digest(encoded)))
+}
