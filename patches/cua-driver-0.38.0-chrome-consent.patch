+#[tokio::test]
+async fn visual_key_delivers_one_page_pair_without_dom_or_foreground_fallback() {
+    for (key, modifiers, command) in [
+        ("enter", json!([]), None),
+        ("a", json!(["shift"]), None),
+        ("tab", json!(["shift"]), None),
+        ("a", json!(["cmd"]), Some("selectAll")),
+        ("z", json!(["cmd", "shift"]), Some("redo")),
+        ("left", json!(["option", "shift"]), Some("moveWordLeftAndModifySelection")),
+    ] {
+        let f = fixture().await;
+        let (target, tab) = bind(&f).await;
+        let observed = GetBrowserStateTool::new(f.engine.clone()).invoke(json!({
+            "target_id": target, "tab_id": tab, "session": SESSION,
+            "snapshot_format": "semantic_v2", "include_screenshot": true, "require_visual_identity": true,
+        })).await;
+        let token = structured(&observed)["screenshot"]["visual_document"].clone();
+        f.state.lock().unwrap().calls.clear();
+        let result = BrowserTypeTool::new(f.engine.clone()).invoke(json!({
+            "target_id": target, "tab_id": tab, "session": SESSION,
+            "mode": "focused_key", "text": key, "modifiers": modifiers, "visual_document": token,
+        })).await;
+        assert_eq!(structured(&result)["status"], "ok", "{result:?}");
+        let calls = recorded_calls(&f, "Input.dispatchKeyEvent");
+        assert_eq!(calls.len(), 2);
+        assert_eq!(calls[0].1["type"], "keyDown");
+        assert_eq!(calls[1].1["type"], "keyUp");
+        assert_eq!(calls[0].0, calls[1].0);
+        if let Some(command) = command { assert_eq!(calls[0].1["commands"], json!([command])); }
+        else { assert!(calls[0].1.get("commands").is_none()); }
+        if key == "enter" { assert_eq!(calls[0].1["text"], "\r"); }
+        if key == "a" && command.is_none() {
+            assert_eq!(calls[0].1["text"], "A");
+            assert_eq!(calls[0].1["unmodifiedText"], "a");
+        }
+        assert!(calls[1].1.get("commands").is_none());
+        assert!(calls[1].1.get("text").is_none());
+        for forbidden in ["DOM.focus", "Runtime.callFunctionOn", "Input.insertText", "Page.bringToFront", "Target.activateTarget"] {
+            assert!(recorded_calls(&f, forbidden).is_empty(), "{forbidden}");
+        }
+        let focus = recorded_calls(&f, "Emulation.setFocusEmulationEnabled");
+        assert_eq!(focus.len(), 2);
+        assert_eq!(focus[1].1["enabled"], false);
+    }
+}
