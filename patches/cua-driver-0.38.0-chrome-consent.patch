+//! Input for a visually selected caret. No DOM focus, selection, setters or ref targets.
+use super::engine::{BrowserEngine, ValidatedTab};
+use super::refusal::{BrowserRefusal, BrowserRefusalCode};
+use crate::protocol::ToolResult;
+use serde_json::{json, Value};
+
+// Security-only inspection; no content or element identifier is returned to the caller.
+// Unknown/cross-origin focused frames fail closed. The model must click from its image first.
+const FOCUSED_INPUT_GUARD: &str = r#"(() => { /* siaVisualFocusGuard */
+  let root = document, field;
+  for (let depth = 0; depth < 32; depth++) {
+    field = root.activeElement;
+    if (!field) return false;
+    if (field.shadowRoot) { root = field.shadowRoot; continue; }
+    if (field.localName === 'iframe' || field.localName === 'frame') {
+      try { root = field.contentDocument; } catch { return false; }
+      if (!root) return false;
+      continue;
+    }
+    if (field.localName === 'input' && /^(password|hidden)$/i.test(field.type)) return false;
+    if (/password|one-time-code|cc-|webauthn/i.test(field.getAttribute('autocomplete') || '')) return false;
+    if (field.closest('form')?.querySelector('input[type=password]')) return false;
+    if (field.matches(':disabled') || field.readOnly) return false;
+    return field.localName === 'textarea' ||
+      (field.localName === 'input' && /^(text|search|email|tel|url|number)$/i.test(field.type)) ||
+      field.isContentEditable === true;
+  }
+  return false;
+})()"#;
+
+pub(super) async fn deliver(
+    engine: &BrowserEngine,
+    tab: &ValidatedTab,
+    args: &Value,
+    text: &str,
+) -> ToolResult {
+    // This first slice is text insertion only. Key commands are a separate validated contract.
+    if args.get("key").is_some() || args.get("keys").is_some() || args.get("modifiers").is_some() {
+        return ToolResult::error("focused text does not accept keyboard commands");
+    }
+    let conn = &tab.conn;
+    let cdp = tab.cdp_session.as_str();
+    let guard = conn
+        .call(
+            Some(cdp),
+            "Runtime.evaluate",
+            json!({
+                "expression": FOCUSED_INPUT_GUARD, "returnByValue": true, "silent": true,
+            }),
+        )
+        .await;
+    if !matches!(guard, Ok(ref reply) if reply.get("exceptionDetails").is_none() && reply.pointer("/result/value").and_then(Value::as_bool) == Some(true))
+    {
+        return BrowserRefusal::new(
+            BrowserRefusalCode::BrowserActionUnavailable,
+            "no permitted focused editable field was proven; no text was sent",
+        )
+        .to_tool_result();
+    }
+    if conn
+        .call(
+            Some(cdp),
+            "Emulation.setFocusEmulationEnabled",
+            json!({"enabled": true}),
+        )
+        .await
+        .is_err()
+    {
+        return BrowserRefusal::new(
+            BrowserRefusalCode::BrowserActionUnavailable,
+            "background focus emulation could not be established; no text was sent",
+        )
+        .to_tool_result();
+    }
+    // Focus emulation can run page focus handlers. Prove the resulting caret again.
+    let guard = conn
+        .call(
+            Some(cdp),
+            "Runtime.evaluate",
+            json!({
+                "expression": FOCUSED_INPUT_GUARD, "returnByValue": true, "silent": true,
+            }),
+        )
+        .await;
+    if !matches!(guard, Ok(ref reply) if reply.get("exceptionDetails").is_none() && reply.pointer("/result/value").and_then(Value::as_bool) == Some(true))
+    {
+        let restored = conn
+            .call(
+                Some(cdp),
+                "Emulation.setFocusEmulationEnabled",
+                json!({"enabled": false}),
+            )
+            .await;
+        return BrowserRefusal::new(
+            BrowserRefusalCode::BrowserActionUnavailable,
+            "focus changed to an unproven field; no text was sent",
+        )
+        .with_detail(json!({"cleanup_confirmed": restored.is_ok(), "retryable": false}))
+        .to_tool_result();
+    }
+    if let Err(refusal) = engine
+        .verify_visual_document(tab, args.get("visual_document").and_then(Value::as_str))
+        .await
+    {
+        let _ = conn
+            .call(
+                Some(cdp),
+                "Emulation.setFocusEmulationEnabled",
+                json!({"enabled": false}),
+            )
+            .await;
+        return refusal.to_tool_result();
+    }
+    let delivered = conn
+        .call(Some(cdp), "Input.insertText", json!({"text": text}))
+        .await;
+    // Always attempt cleanup, including uncertain delivery. Never repeat text after an error.
+    let restored = conn
+        .call(
+            Some(cdp),
+            "Emulation.setFocusEmulationEnabled",
+            json!({"enabled": false}),
+        )
+        .await;
+    if delivered.is_err() || restored.is_err() {
+        return BrowserRefusal::new(BrowserRefusalCode::BrowserInputIncomplete,
+            "focused text delivery or cleanup was uncertain; inspect the tab without replaying input")
+            .with_detail(json!({"retryable": false, "delivery": "unknown"})).to_tool_result();
+    }
+    ToolResult::text("Text delivered to the visually focused field; inspect a fresh screenshot.")
+        .with_structured(json!({
+            "status": "ok", "route": "trusted", "delivery_mode": "background",
+            "target_id": args["target_id"], "tab_id": args["tab_id"], "mode": "focused",
+            "requested_chars": text.chars().count(), "delivered_chars": text.chars().count(),
+        }))
+}
diff --git a/libs/cua-driver/rust/crates/cua-driver-core/src/browser/visual_key.rs b/libs/cua-driver/rust/crates/cua-driver-core/src/browser/visual_key.rs
