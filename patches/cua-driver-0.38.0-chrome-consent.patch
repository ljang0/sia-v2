+//! A focused AppKit popover belongs to its document only through fresh AX ancestry.
+//! Its separate WindowServer surface is matched by exact process and geometry.
+use super::*;
+
+unsafe fn focused_popover(pid: i32, window_id: u32) -> anyhow::Result<Option<RetainedElement>> {
+    let Some(focused) = crate::ax::bindings::focused_element_of_pid(pid) else {
+        return Ok(None);
+    };
+    let mut current = adopt(focused);
+    let mut popover = None;
+    for _ in 0..MAX_DEPTH {
+        let ptr = current.as_ptr() as AXUIElementRef;
+        match copy_string_attr(ptr, "AXRole").as_deref() {
+            Some("AXPopover") => {
+                anyhow::ensure!(popover.is_none(), "nested popover identity is ambiguous");
+                if copy_bool_attr(ptr, "AXHidden") == Some(true)
+                    || copy_bool_attr(ptr, "AXVisible") == Some(false)
+                {
+                    return Ok(None);
+                }
+                popover = Some(current.clone());
+            }
+            Some("AXWindow" | "AXSheet") => {
+                return Ok(if owning_window_id(ptr) == Some(window_id) {
+                    popover
+                } else {
+                    None
+                });
+            }
+            Some("AXApplication") | None => break,
+            _ => {}
+        }
+        let Some(parent) = copy_element_attr(ptr, "AXParent") else {
+            break;
+        };
+        current = adopt(parent);
+    }
+    anyhow::ensure!(popover.is_none(), "popover document ancestry is unproven");
+    Ok(None)
+}
+
+fn match_owned_geometry(
+    pid: i32,
+    document: u32,
+    bounds: Rect,
+    windows: &[WindowInfo],
+) -> anyhow::Result<Popup> {
+    anyhow::ensure!(pid > 0 && bounds.valid(), "popover geometry is unavailable");
+    // Popovers are not necessarily menu-level windows. An AX-owned popover
+    // still needs one separate, visible same-process surface with exact bounds.
+    let mut candidates = windows.iter().filter(|w| {
+        w.pid == pid
+            && w.window_id != document
+            && w.is_on_screen
+            && bounds.near(Rect::from(&w.bounds))
+    });
+    let window = candidates
+        .next()
+        .ok_or_else(|| anyhow::anyhow!("popover has no matching window"))?;
+    anyhow::ensure!(
+        candidates.next().is_none(),
+        "popover window identity is ambiguous"
+    );
+    Ok(Popup {
+        window_id: window.window_id,
+        pid,
+        bounds,
+    })
+}
+
+pub(super) unsafe fn read(
+    pid: i32,
+    window_id: u32,
+    windows: &[WindowInfo],
+) -> anyhow::Result<Option<(RetainedElement, Popup)>> {
+    let Some(element) = focused_popover(pid, window_id)? else {
+        return Ok(None);
+    };
+    let ptr = element.as_ptr() as AXUIElementRef;
+    let mut element_pid = 0;
+    anyhow::ensure!(
+        crate::ax::bindings::AXUIElementGetPid(ptr, &mut element_pid) == 0 && element_pid == pid,
+        "popover process does not match its document"
+    );
+    let [x, y, width, height] = element_screen_rect(ptr)
+        .ok_or_else(|| anyhow::anyhow!("popover geometry is unreadable"))?;
+    let proof = match_owned_geometry(
+        pid,
+        window_id,
+        Rect {
+            x,
+            y,
+            width,
+            height,
+        },
+        windows,
+    )?;
+    // Repeat the ancestry observation before returning a retained surface.
+    let current =
+        focused_popover(pid, window_id)?.ok_or_else(|| anyhow::anyhow!("popover disappeared"))?;
+    anyhow::ensure!(
+        CFEqual(current.as_ptr() as CFTypeRef, element.as_ptr() as CFTypeRef) != 0,
+        "popover changed during lookup"
+    );
+    Ok(Some((element, proof)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn matches_only_one_visible_owned_surface_without_assuming_menu_level() {
+        for level in [0, 3, 101] {
+            let mut surface = super::super::tests::window();
+            surface.layer = level;
+            let bounds = super::super::tests::bounds();
+            assert_eq!(
+                match_owned_geometry(20, 7, bounds, &[surface.clone()])
+                    .unwrap()
+                    .window_id,
+                8
+            );
+            assert!(match_owned_geometry(21, 7, bounds, &[surface.clone()]).is_err());
+            assert!(match_owned_geometry(20, 8, bounds, &[surface.clone()]).is_err());
+            assert!(
+                match_owned_geometry(20, 7, bounds, &[surface.clone(), surface.clone()]).is_err()
+            );
+            surface.is_on_screen = false;
+            assert!(match_owned_geometry(20, 7, bounds, &[surface]).is_err());
+        }
+    }
+
+    #[test]
+    fn rejects_moved_or_invalid_surfaces_and_ignores_other_document_bounds() {
+        let surface = super::super::tests::window();
+        let bounds = super::super::tests::bounds();
+        let mut other = surface.clone();
+        other.window_id = 9;
+        other.bounds.x += 100.0;
+        assert!(match_owned_geometry(20, 7, bounds, &[other.clone()]).is_err());
+        assert_eq!(
+            match_owned_geometry(20, 7, bounds, &[other, surface])
+                .unwrap()
+                .window_id,
+            8
+        );
+        let mut invalid = bounds;
+        invalid.width = f64::NAN;
+        assert!(match_owned_geometry(20, 7, invalid, &[]).is_err());
+    }
+}
