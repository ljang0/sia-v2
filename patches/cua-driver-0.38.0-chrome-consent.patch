+//! An owned popover and its menu, or one menu under an exact window or sheet.
+//! AX proves ancestry/process/geometry; WindowServer supplies the capturable ID.
+mod popover;
+
+use super::*;
+use crate::capture::frame::{Popup, Rect};
+use crate::windows::WindowInfo;
+
+const OPEN_SAVE_PANEL_SERVICE: &str = concat!(
+    "/System/Library/Frameworks/AppKit.framework/Versions/C/XPCServices/",
+    "com.apple.appkit.xpc.openAndSavePanelService.xpc/Contents/MacOS/",
+    "com.apple.appkit.xpc.openAndSavePanelService"
+);
+
+fn service_identity(path: &str, responsible_pid: i32, document_pid: i32) -> bool {
+    document_pid > 0 && path == OPEN_SAVE_PANEL_SERVICE && responsible_pid == document_pid
+}
+
+fn is_document_service(pid: i32, document_pid: i32) -> bool {
+    let Some(path) = crate::apps::path_of_pid(pid) else {
+        return false;
+    };
+    if path != OPEN_SAVE_PANEL_SERVICE {
+        return false;
+    }
+    // Remote AX objects can report the client PID while WindowServer reports
+    // the XPC service. Bind only the exact Apple document service to its responsible client.
+    // This private libSystem symbol is optional: absence must refuse ownership.
+    unsafe {
+        let symbol = libc::dlsym(
+            libc::RTLD_DEFAULT,
+            b"responsibility_get_pid_responsible_for_pid\0"
+                .as_ptr()
+                .cast(),
+        );
+        if symbol.is_null() {
+            return false;
+        }
+        let responsible: unsafe extern "C" fn(i32) -> i32 = std::mem::transmute(symbol);
+        service_identity(&path, responsible(pid), document_pid)
+    }
+}
+
+fn match_window(
+    document_pid: i32,
+    menu_pid: i32,
+    bounds: Rect,
+    windows: &[WindowInfo],
+    document_service: impl Fn(i32, i32) -> bool,
+) -> anyhow::Result<Popup> {
+    anyhow::ensure!(
+        document_pid > 0 && menu_pid > 0 && bounds.valid(),
+        "popup identity is unavailable"
+    );
+    let mut matches = windows.iter().filter(|w| {
+        w.layer == 101
+            && w.is_on_screen
+            && (w.pid == document_pid || document_service(w.pid, document_pid))
+    });
+    let window = matches
+        .next()
+        .ok_or_else(|| anyhow::anyhow!("popup has no matching window"))?;
+    anyhow::ensure!(
+        matches.next().is_none(),
+        "popup window identity is ambiguous"
+    );
+    anyhow::ensure!(
+        (menu_pid == document_pid || menu_pid == window.pid)
+            && bounds.near(Rect::from(&window.bounds)),
+        "popup has no matching window"
+    );
+    Ok(Popup {
+        window_id: window.window_id,
+        pid: window.pid,
+        bounds,
+    })
+}
+
+unsafe fn owned_popups(pid: i32, window_id: u32) -> anyhow::Result<Vec<(RetainedElement, Popup)>> {
+    let Some(sheet) = focused_root(pid, window_id) else {
+        return Ok(Vec::new());
+    };
+    let windows = crate::windows::on_screen_windows_any_layer();
+    let mut found: Vec<_> = popover::read(pid, window_id, &windows)?
+        .into_iter()
+        .collect();
+    let root = found
+        .first()
+        .map_or_else(|| sheet.clone(), |(element, _)| element.clone());
+    // A popover can own an open menu. Keep both surfaces, in paint order;
+    // its backing window must not be mistaken for a second menu candidate.
+    let windows: Vec<_> = windows
+        .into_iter()
+        .filter(|w| {
+            !found
+                .iter()
+                .any(|(_, proof)| proof.window_id == w.window_id)
+        })
+        .collect();
+    // A menu on this backend has a distinct layer-101 window. Avoid traversing
+    // a potentially enormous file listing when there is no popup to capture.
+    // Full surface validation repeats this observation after capture/at dispatch.
+    if !windows.iter().any(|w| w.layer == 101 && w.is_on_screen) {
+        return Ok(found);
+    }
+    let mut stack = vec![(root, 0)];
+    let mut visited = 0;
+    while let Some((element, depth)) = stack.pop() {
+        visited += 1;
+        let ptr = element.as_ptr() as AXUIElementRef;
+        let children = copy_children_checked(ptr)
+            .ok_or_else(|| anyhow::anyhow!("popup subtree is unreadable"))?;
+        let children: Vec<_> = children.into_iter().map(|p| adopt(p)).collect();
+        anyhow::ensure!(
+            visited + stack.len() + children.len() <= MAX_NODES
+                && (depth < MAX_DEPTH || children.is_empty()),
+            "popup scan limit exceeded"
+        );
+        if copy_string_attr(ptr, "AXRole").as_deref() == Some("AXMenu")
+            && copy_bool_attr(ptr, "AXHidden") != Some(true)
+            && copy_bool_attr(ptr, "AXVisible") != Some(false)
+        {
+            let [x, y, width, height] = element_screen_rect(ptr)
+                .ok_or_else(|| anyhow::anyhow!("visible popup has no geometry"))?;
+            let bounds = Rect {
+                x,
+                y,
+                width,
+                height,
+            };
+            anyhow::ensure!(bounds.valid(), "invalid popup geometry");
+            anyhow::ensure!(
+                element_window_id(ptr) == Some(window_id),
+                "popup belongs to another document"
+            );
+            let mut menu_pid = 0;
+            anyhow::ensure!(
+                super::super::bindings::AXUIElementGetPid(ptr, &mut menu_pid) == 0,
+                "popup process is unavailable"
+            );
+            let proof = match_window(pid, menu_pid, bounds, &windows, is_document_service)?;
+            found.push((element.clone(), proof));
+            // match_window proves there is only one popup for this client,
+            // across all bounds, before this ancestry proof is accepted. It is
+            // therefore safe to stop without scanning unrelated file rows.
+            break;
+        }
+        stack.extend(children.into_iter().map(|child| (child, depth + 1)));
+    }
+    let current =
+        focused_root(pid, window_id).ok_or_else(|| anyhow::anyhow!("sheet disappeared"))?;
+    anyhow::ensure!(
+        CFEqual(current.as_ptr() as CFTypeRef, sheet.as_ptr() as CFTypeRef) != 0,
+        "sheet changed during popup lookup"
+    );
+    Ok(found)
+}
+
+pub(crate) fn read(pid: i32, window_id: u32) -> anyhow::Result<Vec<Popup>> {
+    unsafe {
+        Ok(owned_popups(pid, window_id)?
+            .into_iter()
+            .map(|(_, proof)| proof)
+            .collect())
+    }
+}
+
+pub(super) unsafe fn root_at_point(
+    pid: i32,
+    window_id: u32,
+    x: f64,
+    y: f64,
+) -> anyhow::Result<Option<RetainedElement>> {
+    Ok(owned_popups(pid, window_id)?
+        .into_iter()
+        .rev()
+        .find_map(|(element, proof)| proof.bounds.contains(x, y).then_some(element)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    pub(super) fn bounds() -> Rect {
+        Rect {
+            x: 769.0,
+            y: 462.0,
+            width: 302.0,
+            height: 463.0,
+        }
+    }
+    pub(super) fn window() -> WindowInfo {
+        WindowInfo {
+            window_id: 8,
+            pid: 20,
+            app_name: String::new(),
+            title: String::new(),
+            bounds: bounds().into(),
+            layer: 101,
+            z_index: 1,
+            is_on_screen: true,
+            current_space_id: None,
+            on_current_space: None,
+            space_ids: None,
+        }
+    }
+    #[test]
+    fn requires_unique_same_process_popup_with_matching_geometry() {
+        assert_eq!(
+            match_window(20, 20, bounds(), &[window()], |_, _| false)
+                .unwrap()
+                .window_id,
+            8
+        );
+        assert!(match_window(19, 19, bounds(), &[window()], |_, _| false).is_err());
+        assert!(match_window(20, 20, bounds(), &[window(), window()], |_, _| false).is_err());
+        let mut other_menu = window();
+        other_menu.window_id += 1;
+        other_menu.bounds.x += 500.0;
+        // Early ancestry lookup is safe only if another owned popup at any
+        // location is rejected, not just another exact-bounds match.
+        assert!(match_window(20, 20, bounds(), &[window(), other_menu], |_, _| false).is_err());
+        assert!(match_window(20, 20, bounds(), &[], |_, _| false).is_err());
+        for changed in 0..3 {
+            let mut wrong = window();
+            match changed {
+                0 => wrong.layer = 0,
+                1 => wrong.is_on_screen = false,
+                _ => wrong.bounds.x += 1.0,
+            }
+            assert!(match_window(20, 20, bounds(), &[wrong], |_, _| false).is_err());
+        }
+    }
+    #[test]
+    fn client_proxy_requires_the_exact_responsible_panel_service() {
+        let mut service = window();
+        service.pid = 30;
+        let owned = |pid, document| pid == 30 && document == 20;
+        assert_eq!(
+            match_window(20, 20, bounds(), &[service.clone()], owned)
+                .unwrap()
+                .pid,
+            30
+        );
+        assert_eq!(
+            match_window(20, 30, bounds(), &[service.clone()], owned)
+                .unwrap()
+                .pid,
+            30
+        );
+        assert!(match_window(21, 21, bounds(), &[service.clone()], owned).is_err());
+        assert!(match_window(20, 99, bounds(), &[service.clone()], owned).is_err());
+        assert!(match_window(20, 20, bounds(), &[service.clone()], |_, _| false).is_err());
+        assert!(match_window(20, 20, bounds(), &[window(), service.clone()], owned).is_err());
+        assert!(match_window(20, 30, bounds(), &[window(), service], owned).is_err());
+    }
+
+    #[test]
+    fn similarly_named_helpers_and_other_clients_are_not_owned() {
+        assert!(service_identity(OPEN_SAVE_PANEL_SERVICE, 20, 20));
+        assert!(!service_identity(OPEN_SAVE_PANEL_SERVICE, 20, 21));
+        assert!(!service_identity(OPEN_SAVE_PANEL_SERVICE, 21, 20));
+        assert!(!service_identity(
+            "/tmp/com.apple.appkit.xpc.openAndSavePanelService",
+            20,
+            20
+        ));
+        assert!(!service_identity(OPEN_SAVE_PANEL_SERVICE, -1, 20));
+        assert!(!service_identity(OPEN_SAVE_PANEL_SERVICE, 0, 0));
+    }
+
+    #[test]
+    fn rejects_unproven_process_and_invalid_bounds() {
+        assert!(match_window(0, 0, bounds(), &[window()], |_, _| false).is_err());
+        let mut invalid = bounds();
+        invalid.width = f64::NAN;
+        assert!(match_window(20, 20, invalid, &[window()], |_, _| false).is_err());
+    }
+}
