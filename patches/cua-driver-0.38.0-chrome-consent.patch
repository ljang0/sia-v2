+#[tokio::test]
+async fn visual_viewport_change_revokes_pointer_and_text_before_delivery() {
+    for action in ["click", "scroll", "drag", "type"] {
+        for change in ["page_x", "page_y", "offset_x", "offset_y", "width", "height", "scale", "zoom", "missing", "focus"] {
+            let f = fixture().await;
+            let (target, tab) = bind(&f).await;
+            let observed = GetBrowserStateTool::new(f.engine.clone()).invoke(json!({
+                "target_id": target, "tab_id": tab, "session": SESSION,
+                "snapshot_format": "semantic_v2", "include_screenshot": true, "require_visual_identity": true,
+            })).await;
+            let snap = structured(&observed);
+            let token = snap["screenshot"]["visual_document"].as_str().expect("visual token");
+            {
+                let mut state = f.state.lock().unwrap();
+                match change {
+                    "page_x" => state.viewport_page_x = 120.0,
+                    "page_y" => state.viewport_page_y = 120.0,
+                    "offset_x" => state.viewport_offset_x = 10.0,
+                    "offset_y" => state.viewport_offset_y = 10.0,
+                    "width" => state.viewport_css_width = 780.0,
+                    "height" => state.viewport_css_height = 580.0,
+                    "scale" => state.viewport_scale = 1.25,
+                    "zoom" => state.viewport_zoom = 1.25,
+                    "missing" => state.viewport_metrics_missing = true,
+                    "focus" => state.viewport_change_on_focus = true,
+                    _ => unreachable!(),
+                }
+            }
+            let mut args = json!({"target_id": target, "tab_id": tab, "session": SESSION,
+                "visual_document": token, "x": 10, "y": 20,
+                "action": action, "mode": "focused", "text": "one write"});
+            if action == "drag" { args["to_x"] = json!(20); args["to_y"] = json!(30); }
+            if action == "scroll" { args["delta_y"] = json!(100); }
+            let result = match action {
+                "click" => BrowserClickTool::new(f.engine.clone()).invoke(args).await,
+                "type" => BrowserTypeTool::new(f.engine.clone()).invoke(args).await,
+                _ => super::pointer::BrowserPointerTool::new(f.engine.clone()).invoke(args).await,
+            };
+            assert_eq!(structured(&result)["refusal"]["code"], "browser_ref_stale", "{action}/{change}: {result:?}");
+            assert!(recorded_calls(&f, "Input.dispatchMouseEvent").is_empty(), "{action}/{change}");
+            assert!(recorded_calls(&f, "Input.insertText").is_empty(), "{action}/{change}");
+            if change == "focus" {
+                let focus = recorded_calls(&f, "Emulation.setFocusEmulationEnabled");
+                assert_eq!(focus.last().unwrap().1["enabled"], false);
+            }
+        }
+    }
+}
