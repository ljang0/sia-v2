@@ -0,0 +1,150 @@
+//! Keyboard-only native text delivery for vision sessions.
+//! AX may prove focus/ownership, but this module never reads or sets text values.
+//! Exactly one event sequence is posted; screenshots establish the effect.
+
+use super::{
+    AxAttempt, BackgroundKeyboardPolicy, KeyboardRoute, TextDeliveryRoute, TypeTextDelivery,
+    TypeTextOutcome, PATH_KEY_EVENTS, PATH_KEY_EVENTS_FG,
+};
+use crate::ax::{
+    bindings::{copy_string_attr, AXUIElementRef},
+    exact_target::focused_element_in_window,
+};
+use core_foundation::base::CFRelease;
+
+fn preflight(
+    text: &str,
+    delay_ms: u64,
+    route: &KeyboardRoute,
+    physical: bool,
+) -> Option<TypeTextDelivery> {
+    if let BackgroundKeyboardPolicy::SemanticOnly(refusal) = &route.keyboard_policy {
+        return Some(TypeTextDelivery::Refused(refusal.clone()));
+    }
+    super::synthesis_preflight(
+        if physical {
+            TextDeliveryRoute::PhysicalSynthesis
+        } else {
+            TextDeliveryRoute::UnicodeSynthesis
+        },
+        text.chars().count(),
+        delay_ms,
+    )
+    .map(|refusal| TypeTextDelivery::SynthesisRefused {
+        path: if route.delivery_mode.is_foreground() {
+            PATH_KEY_EVENTS_FG
+        } else {
+            PATH_KEY_EVENTS
+        },
+        refusal,
+        ax_attempt: AxAttempt::NotAttempted,
+    })
+}
+
+unsafe fn accepts_text(pid: i32, element: AXUIElementRef) -> bool {
+    // Role/selection existence is a host safety check, never a text observation.
+    if copy_string_attr(element, "AXRole").as_deref() == Some("AXSecureTextField") {
+        return false;
+    }
+    super::focused_accepts_text(element) || super::focused_is_editor_surface(pid, element)
+}
+
+pub(super) fn type_text(
+    pid: i32,
+    text: &str,
+    delay_ms: u64,
+    route: &KeyboardRoute,
+) -> anyhow::Result<TypeTextDelivery> {
+    let physical = crate::input::keyboard::is_screen_sharing_pid(pid);
+    if let Some(refusal) = preflight(text, delay_ms, route, physical) {
+        return Ok(refusal);
+    }
+    let window = route
+        .window_id
+        .ok_or_else(|| anyhow::anyhow!("visual typing needs an exact window"))?;
+    let allowed = unsafe {
+        match focused_element_in_window(pid, window) {
+            Some(element) => {
+                let allowed = accepts_text(pid, element);
+                CFRelease(element as _);
+                allowed
+            }
+            None => false,
+        }
+    };
+    if !allowed {
+        return Ok(TypeTextDelivery::Refused(
+            super::no_focused_text_input_refusal(false),
+        ));
+    }
+    let check = || {
+        route
+            .cancellation
+            .as_ref()
+            .map_or(Ok(()), |checkpoint| checkpoint.check())
+    };
+    check()?;
+    let foreground = route.delivery_mode.is_foreground();
+    if foreground {
+        crate::input::skylight::with_foreground_hid_activation(pid, window, || {
+            if physical {
+                crate::input::keyboard::type_text_physical_global_checked(text, delay_ms, check)
+            } else {
+                crate::input::keyboard::type_text_global_checked(text, delay_ms, check)
+            }
+        })?;
+    } else {
+        crate::input::keyboard::type_text_with_delay_checked(pid, text, delay_ms, check)?;
+    }
+    Ok(TypeTextDelivery::Typed(TypeTextOutcome {
+        detail: " via keyboard events; verify from the fresh screenshot".into(),
+        path: if foreground {
+            PATH_KEY_EVENTS_FG
+        } else {
+            PATH_KEY_EVENTS
+        },
+        verified: false,
+        delivered_chars: None,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cua_driver_core::background_input::BackgroundRefusal;
+    fn route() -> KeyboardRoute {
+        KeyboardRoute {
+            cancellation: None,
+            keyboard_only: true,
+            delivery_mode: super::super::super::DeliveryMode::Background,
+            window_id: Some(7),
+            keyboard_policy: BackgroundKeyboardPolicy::Allowed,
+            explicit_target: false,
+            key_window_confirmed: true,
+        }
+    }
+    #[test]
+    fn refuses_semantic_only_authority_before_any_keyboard_or_ax_access() {
+        let refusal = BackgroundRefusal {
+            code: "test_ambiguous",
+            reason: "another window".into(),
+            advice: None,
+        };
+        let mut route = route();
+        route.keyboard_policy = BackgroundKeyboardPolicy::SemanticOnly(refusal.clone());
+        assert!(
+            matches!(preflight("hello", 30, &route, false), Some(TypeTextDelivery::Refused(actual)) if actual == refusal)
+        );
+    }
+    #[test]
+    fn oversized_visual_text_has_no_atomic_ax_escape_hatch() {
+        assert!(matches!(
+            preflight(&"x".repeat(100_000), 30, &route(), false),
+            Some(TypeTextDelivery::SynthesisRefused {
+                ax_attempt: AxAttempt::NotAttempted,
+                ..
+            })
+        ));
+        assert!(preflight("ordinary filename.txt", 30, &route(), false).is_none());
+    }
+}
