+#[tokio::test]
+async fn visual_key_refuses_stale_or_unsafe_focus_and_cleans_up_uncertain_delivery() {
+    for scenario in ["protected", "focus", "reload", "scroll", "focus_scroll", "press", "release", "cleanup", "clipboard", "no_token"] {
+        let f = fixture().await;
+        let (target, tab) = bind(&f).await;
+        let observed = GetBrowserStateTool::new(f.engine.clone()).invoke(json!({
+            "target_id": target, "tab_id": tab, "session": SESSION,
+            "snapshot_format": "semantic_v2", "include_screenshot": true, "require_visual_identity": true,
+        })).await;
+        let token = structured(&observed)["screenshot"]["visual_document"].clone();
+        {
+            let mut state = f.state.lock().unwrap();
+            state.calls.clear();
+            match scenario {
+                "protected" => state.visual_focus_safe = false,
+                "focus" => state.visual_focus_changes = true,
+                "reload" => state.main_loader = "reloaded".into(),
+                "scroll" => state.viewport_page_y = 150.0,
+                "focus_scroll" => state.viewport_change_on_focus = true,
+                "press" => state.fail_key_down_after = Some(0),
+                "release" => state.visual_key_up_fails = true,
+                "cleanup" => state.visual_focus_restore_fails = true,
+                _ => {},
+            }
+        }
+        let mut args = json!({"target_id": target, "tab_id": tab, "session": SESSION,
+            "mode": "focused_key", "text": "enter", "visual_document": token});
+        if scenario == "clipboard" { args["text"] = json!("c"); args["modifiers"] = json!(["cmd"]); }
+        if scenario == "no_token" { args.as_object_mut().unwrap().remove("visual_document"); }
+        let result = BrowserTypeTool::new(f.engine.clone()).invoke(args).await;
+        let uncertain = matches!(scenario, "press" | "release" | "cleanup");
+        let code = structured(&result)["refusal"]["code"].as_str().unwrap();
+        if uncertain {
+            assert_eq!(code, "browser_input_incomplete");
+            let events = recorded_calls(&f, "Input.dispatchKeyEvent");
+            assert_eq!(events.len(), 2, "{scenario}");
+            assert_eq!(events[1].1["type"], "keyUp");
+        } else {
+            assert_ne!(code, "browser_input_incomplete", "{scenario}");
+            assert!(recorded_calls(&f, "Input.dispatchKeyEvent").is_empty(), "{scenario}");
+        }
+        let focus = recorded_calls(&f, "Emulation.setFocusEmulationEnabled");
+        if matches!(scenario, "protected" | "reload" | "scroll" | "clipboard" | "no_token") {
+            assert!(focus.is_empty(), "{scenario}");
+        } else { assert_eq!(focus.last().unwrap().1["enabled"], false, "{scenario}"); }
+    }
+}
