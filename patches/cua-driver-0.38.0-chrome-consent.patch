+    let inspected = super::tools::BrowserDialogTool::new(f.engine.clone()).invoke(json!({
+        "target_id": target, "tab_id": tab, "session": SESSION, "action": "inspect"
+    })).await;
+    assert_eq!(structured(&inspected)["status"], "ok");
+    let observer = recorded_calls(&f, "Page.enable").last().unwrap().0.clone().unwrap();
+    let snap = semantic_snapshot(&f, &target, &tab).await;
+    assert_eq!(snap["status"], "ok");
+    let attached = f.state.lock().unwrap().tab_sessions;
+    tokio::time::timeout(std::time::Duration::from_secs(1), async {
+        loop {
+            let detached = recorded_calls(&f, "Target.detachFromTarget");
+            if (1..=attached).filter(|id| format!("tab-sess-{id}") != observer)
+                .all(|id| detached.iter().any(|(parent, params)|
+                    parent.is_none() && params["sessionId"] == format!("tab-sess-{id}"))) {
+                assert!(!detached.iter().any(|(_, params)| params["sessionId"] == observer),
+                    "dialog events must keep arriving between operations");
+                break;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+        }
+    }).await.expect("temporary sessions must be released while the observer stays attached");
+}
